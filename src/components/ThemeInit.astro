<!-- Applies stored fun mode and light/dark before first paint (no flash). -->
<script is:inline>
  try {
    const root = document.documentElement;
    if (localStorage.getItem('rc-theme') === 'fun') {
      root.dataset.theme = 'fun';
      // Likely to run the 3D views: hide the 2D art they replace from the start (fun-3d/index.js
      // removes this again if 3D can't start).
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches || navigator.connection?.saveData;
      if (window.WebGL2RenderingContext && !calm) root.classList.add('wants-3d');
    }
    const scheme = localStorage.getItem('rc-scheme');
    root.dataset.scheme = scheme === 'light' || scheme === 'dark' ? scheme : matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
  } catch (e) {}
</script>
