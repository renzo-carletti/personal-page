---
import Icon from './Icon.astro';
import PixelSprite from './fun/PixelSprite.astro';
import { campfire, vivi } from './fun/sprites.js';
import { profile, site as siteConfig, translations } from '../data/content.js';
const en = translations.en;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const fields = [
  { name: 'name', type: 'text', autocomplete: 'name' },
  { name: 'email', type: 'email', autocomplete: 'email' },
  { name: 'subject', type: 'text', autocomplete: 'off' },
];
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container section__grid">
    <header class="section__head">
      <span class="section__num">06</span>
      <span class="fun-only fun-label" aria-hidden="true" data-i18n="fun.contact">{en['fun.contact']}</span>
      <h2 id="contact-title" class="section__title" data-i18n="contact.title">{en['contact.title']}</h2>
    </header>

    <div class="contact">
      <div class="contact__lead">
        <div class="fun-only savepoint">
          <div class="savepoint__scene" aria-hidden="true">
            <PixelSprite sprite={vivi} class="savepoint__vivi" />
            <PixelSprite sprite={campfire} class="savepoint__fire" />
          </div>
          <p class="savepoint__text" data-i18n="fun.save">{en['fun.save']}</p>
        </div>
        <p class="contact__headline" data-i18n="contact.headline">{en['contact.headline']}</p>
        <p class="contact__sub" data-i18n="contact.sub">{en['contact.sub']}</p>
        <div class="contact__email">
          <a class="contact__mail" href={`mailto:${profile.email}`}>{profile.email}</a>
          <button type="button" class="contact__copy no-print" aria-label={en['contact.copyEmail']} data-i18n="contact.copyEmail" data-i18n-attr="aria-label">
            <Icon name="copy" />
          </button>
          <span class="contact__copied" role="status" aria-live="polite"></span>
        </div>
      </div>

      <div class="contact__info">
        <ul class="contact__links" role="list">
          <li>
            <Icon name="linkedin" />
            <span class="contact__label" data-i18n="contact.linkedin">{en['contact.linkedin']}</span>
            <a class="link" href={profile.linkedin} target="_blank" rel="noopener noreferrer" data-print-url="false">{profile.linkedinLabel}</a>
          </li>
          <li>
            <Icon name="github" />
            <span class="contact__label">GitHub</span>
            <a class="link" href={profile.github} target="_blank" rel="noopener noreferrer" data-print-url="false">{profile.github.replace('https://', '')}</a>
          </li>
          <li>
            <Icon name="phone" />
            <span class="contact__label" data-i18n="contact.phone">{en['contact.phone']}</span>
            <a class="link" href={`tel:${profile.phone.replace(/\s/g, '')}`}>{profile.phone}</a>
          </li>
        </ul>
        <a class="btn btn--ghost no-print" href={base + 'renzo-carletti-cv.pdf'} download data-cv>
          <Icon name="download" size={16} />
          <span data-i18n="nav.download">{en['nav.download']}</span>
        </a>
      </div>

      <form
        id="contact-form"
        class="contact__form"
        action="https://api.web3forms.com/submit"
        method="POST"
        data-email={profile.email}
        data-form-key={siteConfig.web3FormsKey}
      >
        <!-- Without JS the form still posts to Web3Forms. The key only delivers to my inbox, so it is safe in public. -->
        <input type="hidden" name="access_key" value={siteConfig.web3FormsKey} />
        <!-- Honeypot: bots tick it, Web3Forms drops those submissions. -->
        <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
        {fields.map((f) => (
          <div class="field">
            <label for={`cf-${f.name}`} data-i18n={`contact.form.${f.name}`}>{en[`contact.form.${f.name}`]}</label>
            <input
              id={`cf-${f.name}`}
              type={f.type}
              name={f.name}
              required
              autocomplete={f.autocomplete}
              placeholder={en[`contact.form.${f.name}Ph`]}
              data-i18n={`contact.form.${f.name}Ph`}
              data-i18n-attr="placeholder"
            />
          </div>
        ))}
        <div class="field">
          <label for="cf-message" data-i18n="contact.form.message">{en['contact.form.message']}</label>
          <textarea
            id="cf-message"
            name="message"
            rows="5"
            required
            placeholder={en['contact.form.messagePh']}
            data-i18n="contact.form.messagePh"
            data-i18n-attr="placeholder"
          ></textarea>
        </div>
        <div class="contact__actions">
          <button type="submit" class="btn btn--primary" data-i18n="contact.submit">{en['contact.submit']}</button>
          <button type="button" id="copy-msg" class="btn btn--ghost" hidden data-i18n="contact.copy">{en['contact.copy']}</button>
        </div>
        <p class="contact__hint" role="status" aria-live="polite" data-i18n="contact.hint">{en['contact.hint']}</p>
        {siteConfig.booking && (
          <p class="contact__book">
            <a class="link" href={siteConfig.booking} target="_blank" rel="noopener noreferrer" data-i18n="contact.book">{en['contact.book']}</a>
          </p>
        )}
      </form>
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 1100px) {
    .contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .contact__lead {
    grid-column: 1 / -1;
    padding-bottom: var(--space-7);
    border-bottom: var(--border-1) solid var(--line);
  }

  .contact__headline {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 1.5rem + 2.4vw, 3.6rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.05;
    max-width: 18ch;
    text-wrap: balance;
  }

  .contact__sub {
    margin-top: var(--space-5);
    color: var(--muted);
    max-width: 52ch;
  }

  .contact__email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .contact__mail {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    overflow-wrap: anywhere;
    transition: text-decoration-color var(--dur-fast);
  }

  .contact__mail:hover {
    text-decoration-color: currentColor;
  }

  .contact__copy {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--muted);
    border: var(--border-1) solid var(--line-strong);
    border-radius: var(--radius-sm);
    transition: color var(--dur-fast), border-color var(--dur-fast);
  }

  .contact__copy:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .contact__copied {
    font-size: var(--text-sm);
    color: var(--success);
  }

  .contact__links {
    display: grid;
    margin-bottom: var(--space-6);
  }

  .contact__links li {
    display: grid;
    grid-template-columns: auto 6rem minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-bottom: var(--border-1) solid var(--line);
    font-size: var(--text-sm);
    color: var(--faint);
  }

  .contact__links .link {
    overflow-wrap: anywhere;
  }

  .contact__form {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .field {
    display: grid;
    gap: var(--space-1);
  }

  .field label {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .field input,
  .field textarea {
    width: 100%;
    font: inherit;
    color: var(--text);
    background: var(--surface);
    border: var(--border-1) solid var(--line-strong);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    transition: border-color var(--dur-fast);
  }

  .field textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .field input:hover,
  .field textarea:hover {
    border-color: var(--faint);
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 0;
    border-color: transparent;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .contact__actions [hidden] {
    display: none;
  }

  .contact__hint,
  .contact__book {
    font-size: var(--text-sm);
    color: var(--muted);
  }
</style>

<script>
  import { currentLang } from '../scripts/i18n.js';
  import { translations, defaultLang } from '../data/content.js';

  const form = document.getElementById('contact-form');
  const status = document.querySelector('.contact__hint');
  const copyBtn = document.getElementById('copy-msg');
  const email = form.dataset.email;
  const formKey = form.dataset.formKey;

  const t = (key) => (translations[currentLang()] ?? translations[defaultLang])[key];

  let lastBody = '';

  function setStatus(key, extra = '') {
    status.textContent = (t(key) ?? '') + extra;
  }

  function openMail(subject, body) {
    window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    setStatus('contact.opening', email);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const el = (n) => form.elements.namedItem(n);
    const name = el('name').value.trim();
    const from = el('email').value.trim();
    const subjectLine = el('subject').value.trim();
    const message = el('message').value.trim();

    const subject = `[Portfolio] ${subjectLine}`;
    const body = `Name: ${name}\nEmail: ${from}\n\n${message}`;
    lastBody = body;
    copyBtn.hidden = false;

    if (!formKey) return openMail(subject, body);

    setStatus('contact.sending');
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: formKey,
          subject,
          from_name: 'Portfolio contact form',
          name,
          email: from,
          replyto: from,
          message,
          botcheck: el('botcheck').checked,
        }),
      });
      const json = await res.json();
      if (!json.success) throw new Error(json.message || 'error');
      setStatus('contact.success');
      form.reset();
      copyBtn.hidden = true;
    } catch {
      openMail(subject, body);
    }
  });

  const copyEmailBtn = document.querySelector('.contact__copy');
  const copied = document.querySelector('.contact__copied');
  let copiedTimer;
  copyEmailBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(email);
      copied.textContent = t('contact.emailCopied');
    } catch {
      copied.textContent = t('contact.copyFail');
    }
    clearTimeout(copiedTimer);
    copiedTimer = setTimeout(() => (copied.textContent = ''), 3000);
  });

  copyBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(lastBody);
      setStatus('contact.copied');
    } catch {
      setStatus('contact.copyFail');
    }
  });
</script>
