---
import { projects, t, translations } from '../data/content.js';
const en = translations.en;
---

<section id="work" class="container">
  <div class="section-head reveal">
    <span class="kicker" data-i18n="work.kicker">{en['work.kicker']}</span>
    <h2 data-i18n="work.title" data-fun-fx="title">{en['work.title']}</h2>
  </div>

  <div class="work__grid">
    {projects.map((p, i) => (
      <article
        class={`glass work__card${p.featured ? ' work__card--featured' : ''} reveal`}
        style={`--d:${i * 0.07}s`}
      >
        <div class="work__head">
          <div>
            <span class="work__role" data-i18n={`work.role.${p.role}`}>{en[`work.role.${p.role}`]}</span>
            <h3 class="work__name" data-i18n={`work.${i}.name`}>{t(p.name)}</h3>
            <p class="work__tagline" data-i18n={`work.${i}.tagline`}>{t(p.tagline)}</p>
          </div>
        </div>
        <p class="work__desc" data-i18n={`work.${i}.desc`}>{t(p.desc)}</p>
        <div class="work__foot">
          <div class="work__tags">
            {p.tech.map((tag) => (
              <span class="work__tag">{tag}</span>
            ))}
          </div>
          {p.metric && (
            <span class="work__metric" data-i18n={`work.${i}.metric`}>{t(p.metric)}</span>
          )}
        </div>
        <div class="work__actions">
          <a class="work__link" href={p.url} target="_blank" rel="noopener noreferrer">
            <span data-i18n="work.visit">{en['work.visit']}</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17L17 7M7 7h10v10" />
            </svg>
          </a>
          <button class="work__link" type="button" data-case={i}>
            <span data-i18n="work.case">{en['work.case']}</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
            </svg>
          </button>
        </div>
      </article>
    ))}
  </div>

  {projects.map((p, i) => (
    <dialog class="case-modal" id={`case-${i}`} aria-labelledby={`case-title-${i}`}>
      <div class="case-modal__head">
        <h3 class="case-modal__title" id={`case-title-${i}`} data-i18n={`work.${i}.name`}>{t(p.name)}</h3>
        <button class="case-modal__close" type="button" data-close aria-label="Close" data-i18n="case.close" data-i18n-attr="aria-label">×</button>
      </div>
      <div class="case-modal__body">
        <div class="case-modal__block">
          <h4 data-i18n="case.problem">{en['case.problem']}</h4>
          <p data-i18n={`case.${i}.problem`}>{t(p.case.problem)}</p>
        </div>
        <div class="case-modal__block">
          <h4 data-i18n="case.solution">{en['case.solution']}</h4>
          <p data-i18n={`case.${i}.solution`}>{t(p.case.solution)}</p>
        </div>
        <div class="case-modal__block case-modal__block--impact">
          <h4 data-i18n="case.impact">{en['case.impact']}</h4>
          <p data-i18n={`case.${i}.impact`}>{t(p.case.impact)}</p>
        </div>
      </div>
    </dialog>
  ))}
</section>

<style>
  .work__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
  }

  .work__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.8rem;
    transition: transform 0.3s var(--ease), border-color 0.3s, background 0.3s, box-shadow 0.3s;
  }

  .work__card:hover {
    transform: translateY(-4px);
    background: var(--glass-strong);
    box-shadow: 0 18px 48px -18px color-mix(in srgb, var(--accent-1) 45%, transparent);
  }

  .work__card--featured {
    position: relative;
    background:
      linear-gradient(var(--glass-strong), var(--glass-strong)) padding-box,
      linear-gradient(120deg, color-mix(in srgb, var(--accent-1) 60%, transparent), color-mix(in srgb, var(--accent-2) 60%, transparent)) border-box;
    border: 1px solid transparent;
  }

  .work__card--featured:hover {
    box-shadow: 0 20px 52px -18px color-mix(in srgb, var(--accent-3) 50%, transparent);
  }

  .work__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .work__role {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-2);
    background: color-mix(in srgb, var(--accent-2) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-2) 25%, transparent);
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    margin-bottom: 0.8rem;
  }

  .work__name {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .work__tagline {
    margin-top: 0.2rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .work__actions {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.2rem;
    flex-wrap: wrap;
  }

  .work__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--glass-border);
    background: var(--glass);
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 600;
    transition: color 0.25s, border-color 0.25s, background 0.25s, transform 0.25s var(--ease);
  }

  .work__link:hover {
    color: var(--text);
    border-color: color-mix(in srgb, var(--accent-2) 50%, transparent);
    background: var(--glass-hover);
    transform: translateY(-1px);
  }

  .work__desc {
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: 0.95rem;
    flex: 1;
  }

  .work__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 1.4rem;
    flex-wrap: wrap;
  }

  .work__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .work__tag {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--glass-border);
    color: var(--muted);
    background: color-mix(in srgb, var(--accent-1) 8%, transparent);
  }

  .work__metric {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-3);
    background: color-mix(in srgb, var(--accent-3) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-3) 30%, transparent);
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    white-space: nowrap;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 560px) {
    .work__metric {
      white-space: normal;
      text-align: center;
    }
  }

  @media (max-width: 860px) {
    .work__grid {
      grid-template-columns: 1fr;
    }
  }

  /* Case study modal */
  .case-modal {
    max-width: 560px;
    width: calc(100vw - 2.5rem);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg-elevated) 92%, transparent);
    color: var(--text);
    padding: 1.8rem;
    margin: auto;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .case-modal::backdrop {
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .case-modal[open] {
    animation: modal-in 0.25s var(--ease);
  }

  @keyframes modal-in {
    from { opacity: 0; transform: translateY(14px) scale(0.98); }
    to { opacity: 1; transform: none; }
  }

  .case-modal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.4rem;
  }

  .case-modal__title {
    font-size: 1.35rem;
    font-weight: 700;
  }

  .case-modal__close {
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    border: 1px solid var(--glass-border);
    background: var(--glass);
    color: var(--muted);
    font-size: 1.2rem;
    line-height: 1;
    transition: color 0.25s, border-color 0.25s, transform 0.25s var(--ease);
  }

  .case-modal__close:hover {
    color: var(--text);
    border-color: var(--accent-2);
    transform: rotate(90deg);
  }

  .case-modal__block + .case-modal__block {
    margin-top: 1.2rem;
  }

  .case-modal__block h4 {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-2);
    margin-bottom: 0.4rem;
  }

  .case-modal__block p {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .case-modal__block--impact p {
    color: var(--text);
  }

  .case-modal__block--impact {
    border-top: 1px solid var(--glass-border);
    padding-top: 1.2rem;
  }
</style>

<script>
  document.querySelectorAll('[data-case]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const dialog = document.getElementById(`case-${btn.dataset.case}`);
      if (dialog && typeof dialog.showModal === 'function') dialog.showModal();
    });
  });

  document.querySelectorAll('[data-close]').forEach((btn) => {
    btn.addEventListener('click', () => btn.closest('dialog')?.close());
  });

  document.querySelectorAll('.case-modal').forEach((dialog) => {
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>