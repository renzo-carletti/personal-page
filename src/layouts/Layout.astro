---
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import interLatinExt from '@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2?url';
import jbLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import jbLatinExt from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-ext-wght-normal.woff2?url';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { profile } from '../data/cv.js';

const { title = 'Renzo Carletti · Decoupled Drupal & React Engineer' } = Astro.props;

const siteUrl = (Astro.site ?? 'https://renzocarletti.dev').href.replace(/\/$/, '');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const fontCss = `
@font-face {
  font-family: 'Inter Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 900;
  src: url('${interLatin}') format('woff2-variations');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'Inter Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 900;
  src: url('${interLatinExt}') format('woff2-variations');
  unicode-range: U+0100-024F, U+0259, U+1E00-1EFF, U+2020, U+20A0-20AB, U+20AD-20CF, U+2113, U+2C60-2C7F, U+A720-A7FF;
}
@font-face {
  font-family: 'JetBrains Mono Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 800;
  src: url('${jbLatin}') format('woff2-variations');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'JetBrains Mono Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 800;
  src: url('${jbLatinExt}') format('woff2-variations');
  unicode-range: U+0100-024F, U+0259, U+1E00-1EFF, U+2020, U+20A0-20AB, U+20AD-20CF, U+2113, U+2C60-2C7F, U+A720-A7FF;
}
`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  telephone: profile.phone.replace(/\s/g, ''),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Paraná',
    addressRegion: 'Entre Ríos',
    addressCountry: 'AR',
  },
  url: siteUrl,
  sameAs: [profile.linkedin, profile.github],
  knowsAbout: [
    'React.js', 'Drupal', 'Moodle', 'REST APIs', 'JSON:API', 'OAuth2',
    'PHP', 'Headless CMS', 'DevOps', 'Docker', 'Kubernetes', 'AWS',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Renzo Emiliano Carletti, Decoupled Drupal + React expert. Headless CMS architect, JSON:API & OAuth2 specialist. 5+ years shipping high-performance web applications." />
    <meta name="keywords" content="Decoupled Drupal Expert, Headless CMS, React Developer, JSON:API, OAuth2, REST APIs, Drupal 10/11, Moodle, PHP, Symfony, DevOps, Web Performance, Argentina" />
    <meta name="author" content="Renzo Emiliano Carletti" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#05060f" />
    <meta name="color-scheme" content="dark" />
    <script is:inline>
      try {
        if (localStorage.getItem('rc-theme') === 'fun') document.documentElement.dataset.theme = 'fun';
        const low = (navigator.hardwareConcurrency || 8) <= 4 || (navigator.deviceMemory || 8) <= 4;
        if (low) document.documentElement.classList.add('low-power');
      } catch (e) {}
    </script>
    <link rel="icon" type="image/svg+xml" href={base + 'favicon.svg'} />
    <link rel="canonical" href={siteUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Decoupled Drupal & React engineer. 5+ years building fast, scalable web applications." />
    <meta property="og:image" content={`${siteUrl}/og.png`} />
    <meta property="og:site_name" content="Renzo Carletti" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${siteUrl}/og.png`} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="Decoupled Drupal & React engineer. 5+ years building fast, scalable web applications." />

    <title>{title}</title>

    <style is:global set:html={fontCss} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="aurora" aria-hidden="true">
      <div class="aurora__blob aurora__blob--1"></div>
      <div class="aurora__blob aurora__blob--2"></div>
      <div class="aurora__blob aurora__blob--3"></div>
      <div class="aurora__grid"></div>
    </div>
    <div class="noise" aria-hidden="true"></div>
    <Nav />
    <div id="scroll-progress" class="scroll-progress" aria-hidden="true"></div>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <button id="back-to-top" class="back-to-top" aria-label="Back to top">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7" />
      </svg>
    </button>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script>
      import '../scripts/reveal.js';
      import '../scripts/scroll-ui.js';
    </script>
  </body>
</html>