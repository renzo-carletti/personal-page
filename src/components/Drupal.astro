---
import Icon from './Icon.astro';
import NomaiWall from './fun/NomaiWall.astro';
import { drupal, t, translations } from '../data/content.js';
const en = translations.en;
---

<section id="drupal" class="section" aria-labelledby="drupal-title">
  <div class="container section__grid">
    <header class="section__head">
      <span class="section__num">03<span class="pro-only section__of" aria-hidden="true">/ 06</span></span>
      <span class="fun-only fun-label" aria-hidden="true" data-i18n="fun.drupal">{en['fun.drupal']}</span>
      <h2 id="drupal-title" class="section__title" data-i18n="drupal.title">{en['drupal.title']}</h2>
      <p class="section__intro" data-i18n="drupal.intro">{en['drupal.intro']}</p>
      <p class="drupal__versions" data-i18n="drupal.versions">{t(drupal.versions)}</p>
    </header>

    <div class="drupal">
      <dl class="drupal__list">
        {drupal.items.map((item, i) => (
          <div>
            <dt data-i18n={`drupal.${i}.title`}>{t(item.title)}</dt>
            <dd data-i18n={`drupal.${i}.proof`}>{t(item.proof)}</dd>
          </div>
        ))}
      </dl>

      <div class="drupal__side">
        <figure class="arch">
          <figcaption class="label" data-i18n="workflow.arch.title">{en['workflow.arch.title']}</figcaption>
          <ol class="arch__flow" role="list">
            <li class="arch__node">
              <Icon name="drop" size={22} class="arch__icon" />
              <strong data-i18n="workflow.arch.drupal">{en['workflow.arch.drupal']}</strong>
              <span data-i18n="workflow.arch.drupalSub">{en['workflow.arch.drupalSub']}</span>
            </li>
            <li class="arch__link"><span data-i18n="workflow.arch.api">{en['workflow.arch.api']}</span></li>
            <li class="arch__node">
              <Icon name="atom" size={22} class="arch__icon" />
              <strong data-i18n="workflow.arch.react">{en['workflow.arch.react']}</strong>
              <span data-i18n="workflow.arch.reactSub">{en['workflow.arch.reactSub']}</span>
            </li>
          </ol>
          <p class="arch__why" data-i18n="workflow.arch.why">{en['workflow.arch.why']}</p>
        </figure>

        <div class="drupal__ai">
          <h3 class="label" data-i18n="workflow.ai.title">{en['workflow.ai.title']}</h3>
          <p data-i18n="workflow.ai.text">{en['workflow.ai.text']}</p>
        </div>

        <NomaiWall />

        <!-- Cyberpunk 2077 tribute (fun-cyber.js): a locked access point. "Jack in" opens a timed
             Breach Protocol; winning turns on Night City mode. -->
        <section class="fun-only breach" aria-labelledby="breach-title">
          <p class="breach__kicker" data-i18n="fun.breach.kicker">{en['fun.breach.kicker']}</p>
          <h3 id="breach-title" class="breach__title" data-i18n="fun.breach.title">{en['fun.breach.title']}</h3>
          <p class="breach__prompt"><span aria-hidden="true">&gt; </span><span class="breach__state" data-i18n="fun.breach.idle">{en['fun.breach.idle']}</span><span class="breach__cursor" aria-hidden="true"></span></p>
          <button class="breach__jack btn" type="button" data-i18n="fun.breach.jack">{en['fun.breach.jack']}</button>
        </section>
        <div class="fun-only breach-term" role="dialog" aria-modal="true" aria-labelledby="breach-term-title" hidden>
          <div class="breach-term__window">
            <header class="breach-term__head">
              <h3 id="breach-term-title" class="breach__title" data-i18n="fun.breach.title">{en['fun.breach.title']}</h3>
              <button class="breach-term__close" type="button" aria-label={en['fun.breach.close']} data-i18n="fun.breach.close" data-i18n-attr="aria-label">✕</button>
            </header>
            <div class="breach-term__timer" aria-hidden="true"><span></span></div>
            <p class="breach__help" data-i18n="fun.breach.help">{en['fun.breach.help']}</p>
            <p class="breach__line"><span data-i18n="fun.breach.seq">{en['fun.breach.seq']}</span> <span class="breach__seq"></span></p>
            <p class="breach__line"><span data-i18n="fun.breach.buffer">{en['fun.breach.buffer']}</span> <span class="breach__buf"></span></p>
            <div class="breach__grid"></div>
            <p class="breach__status" role="status" aria-live="polite"></p>
            <button class="breach__reset btn" type="button" hidden data-i18n="fun.breach.reset">{en['fun.breach.reset']}</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .drupal__versions {
    display: inline-block;
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
    padding: 0.15rem var(--space-2);
    border: var(--border-1) solid currentColor;
    border-radius: var(--radius-xs);
  }

  .drupal {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 1100px) {
    .drupal {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }
  }

  .drupal__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-5) var(--space-6);
  }

  .drupal__list > div {
    padding-top: var(--space-3);
    border-top: var(--border-2) solid var(--line);
  }

  :global(:root:not([data-theme='fun'])) .drupal__list > div:hover {
    border-top-color: var(--accent);
  }

  .drupal__list > div {
    transition: border-color var(--dur-base) var(--ease);
  }

  .drupal__list dt {
    font-weight: 600;
  }

  .drupal__list dd {
    margin-top: var(--space-1);
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .drupal__side {
    display: grid;
    gap: var(--space-6);
    align-content: start;
  }

  .arch {
    padding: var(--space-5);
    background: var(--surface);
    border: var(--border-1) solid var(--line);
    border-radius: var(--radius);
  }

  .arch__flow {
    display: grid;
    margin-block: var(--space-4);
  }

  .arch__node {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--space-3);
    align-items: center;
    padding: var(--space-3) var(--space-4);
    background: var(--bg);
    border: var(--border-1) solid var(--line-strong);
    border-radius: var(--radius-sm);
  }

  .arch__node :global(.arch__icon) {
    grid-row: span 2;
    color: var(--accent);
  }

  .arch__node span {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--faint);
  }

  /* Connector: dashed rule with the protocol as a chip on it. */
  .arch__link {
    position: relative;
    padding: var(--space-4) 0 var(--space-4) calc(var(--space-4) + 2px);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
  }

  .arch__link span {
    position: relative;
    display: inline-block;
    padding: 0.1rem var(--space-2);
    background: color-mix(in srgb, var(--accent) 12%, var(--surface));
    border: var(--border-1) solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: var(--radius-pill);
  }

  .arch__link::before {
    content: '';
    position: absolute;
    left: calc(var(--space-4) + 10px);
    top: 0;
    bottom: 0;
    border-left: var(--border-2) dashed var(--accent);
  }

  .arch__why,
  .drupal__ai p {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .drupal__ai p {
    margin-top: var(--space-2);
  }

  @media print {
    .drupal__side {
      display: none;
    }
  }
</style>
