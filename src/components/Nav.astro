---
import Icon from './Icon.astro';
import { translations } from '../data/content.js';
const en = translations.en;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const links = [
  { href: '#work', i18n: 'nav.work' },
  { href: '#experience', i18n: 'nav.experience' },
  { href: '#drupal', i18n: 'nav.drupal' },
  { href: '#skills', i18n: 'nav.skills' },
  { href: '#contact', i18n: 'nav.contact' },
];
---

<header class="nav">
  <div class="container nav__inner">
    <a class="nav__brand" href="#top" aria-label={en['nav.home']} data-i18n="nav.home" data-i18n-attr="aria-label">
      Renzo Carletti
      <span class="fun-only hud-lv" aria-hidden="true" data-i18n="fun.lv">{en['fun.lv']}</span>
    </a>

    <nav class="nav__menu" id="nav-menu" aria-label="Primary">
      <ul class="nav__links" role="list">
        {links.map((l) => (
          <li><a href={l.href} data-i18n={l.i18n}>{en[l.i18n]}</a></li>
        ))}
      </ul>

      <div class="nav__controls" role="group" aria-label="Language and appearance">
        <div class="nav__langs">
          <button data-lang-btn="en" class="nav__lang" aria-pressed="false" aria-label="English">EN</button>
          <button data-lang-btn="es" class="nav__lang" aria-pressed="false" aria-label="Español">ES</button>
        </div>
        <button class="nav__icon nav__scheme" aria-pressed="false" aria-label={en['nav.scheme']} data-i18n="nav.scheme" data-i18n-attr="aria-label">
          <Icon name="moon" class="icon-moon" />
          <Icon name="sun" class="icon-sun" />
        </button>
        <button class="nav__icon nav__theme" aria-pressed="false" aria-label={en['nav.theme']} data-i18n="nav.theme" data-i18n-attr="aria-label">
          <Icon name="gamepad" />
        </button>
        <a class="btn btn--primary nav__cv" href={base + 'cv.pdf'} download data-cv>
          <Icon name="download" size={16} />
          <span data-i18n="nav.download">{en['nav.download']}</span>
        </a>
      </div>
    </nav>

    <button class="nav__icon nav__toggle" aria-expanded="false" aria-controls="nav-menu">
      <Icon name="menu" class="icon-open" />
      <Icon name="close" class="icon-close" />
      <span class="visually-hidden" data-i18n="nav.menu">{en['nav.menu']}</span>
    </button>
  </div>
  <div class="fun-only hud-xp" aria-hidden="true"><span></span></div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
    background: var(--bg);
    border-bottom: var(--border-1) solid transparent;
    transition: border-color var(--dur-base);
  }

  .nav.scrolled {
    border-bottom-color: var(--line);
  }

  .nav__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .nav__brand {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav__menu {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav__links {
    display: flex;
    gap: var(--space-5);
  }

  .nav__links a {
    font-size: var(--text-sm);
    color: var(--muted);
    text-decoration: none;
    padding-block: var(--space-2);
    border-bottom: var(--border-2) solid transparent;
    transition: color var(--dur-fast), border-color var(--dur-fast);
  }

  .nav__links a:hover,
  .nav__links a[aria-current='true'] {
    color: var(--text);
  }

  .nav__links a[aria-current='true'] {
    border-bottom-color: var(--accent);
  }

  .nav__controls {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .nav__langs {
    display: flex;
    border: var(--border-1) solid var(--line-strong);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .nav__lang {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    min-width: 2.5rem;
    min-height: 2.5rem;
    color: var(--muted);
  }

  .nav__lang[aria-pressed='true'] {
    background: var(--text);
    color: var(--bg);
  }

  .nav__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-sm);
    color: var(--muted);
    transition: color var(--dur-fast), background-color var(--dur-fast);
  }

  .nav__icon:hover {
    color: var(--text);
    background: var(--accent-soft);
  }

  .nav__theme[aria-pressed='true'] {
    color: var(--accent);
  }

  /* Icon shows the scheme you switch to. */
  :global(:root[data-scheme='dark']) .nav__scheme :global(.icon-moon),
  :global(:root[data-scheme='light']) .nav__scheme :global(.icon-sun) {
    display: none;
  }

  :global(:root[data-theme='fun']) .nav__scheme {
    display: none;
  }

  .nav__toggle {
    display: none;
  }

  .nav__toggle :global(.icon-close),
  .nav__toggle[aria-expanded='true'] :global(.icon-open) {
    display: none;
  }

  .nav__toggle[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }

  @media (max-width: 1000px) {
    .nav__toggle {
      display: grid;
    }

    .nav__menu {
      display: none;
      position: absolute;
      top: var(--nav-h);
      inset-inline: 0;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-5);
      padding: var(--space-5) var(--gutter) var(--space-6);
      background: var(--bg);
      border-bottom: var(--border-1) solid var(--line);
      box-shadow: var(--shadow-lg);
    }

    .nav__menu.open {
      display: flex;
    }

    .nav__links {
      flex-direction: column;
      gap: 0;
    }

    .nav__links a {
      display: block;
      font-size: var(--text-md);
      padding-block: var(--space-3);
      border-bottom: var(--border-1) solid var(--line);
    }

    .nav__controls {
      flex-wrap: wrap;
    }

    .nav__cv {
      margin-left: auto;
    }
  }
</style>

<script>
  import { setLang } from '../scripts/i18n.js';

  const root = document.documentElement;
  const header = document.querySelector('.nav');
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile menu
  const toggle = document.querySelector('.nav__toggle');
  const menu = document.getElementById('nav-menu');
  function setMenu(open) {
    toggle.setAttribute('aria-expanded', String(open));
    menu.classList.toggle('open', open);
  }
  toggle.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      toggle.focus();
    }
  });

  document.querySelectorAll('[data-lang-btn]').forEach((btn) => {
    btn.addEventListener('click', () => setLang(btn.dataset.langBtn));
  });

  const themeColor = document.querySelector('meta[name="theme-color"]');
  const syncThemeColor = () => {
    if (themeColor) themeColor.content = getComputedStyle(root).getPropertyValue('--bg').trim();
  };

  // Light/dark. An explicit choice is stored; otherwise follow the OS setting.
  const SCHEME_KEY = 'rc-scheme';
  const schemeBtn = document.querySelector('.nav__scheme');
  const prefersLight = window.matchMedia('(prefers-color-scheme: light)');
  function storedScheme() {
    try {
      const v = localStorage.getItem(SCHEME_KEY);
      return v === 'light' || v === 'dark' ? v : null;
    } catch {
      return null;
    }
  }
  function applyScheme(scheme) {
    root.dataset.scheme = scheme;
    schemeBtn.setAttribute('aria-pressed', String(scheme === 'dark'));
    syncThemeColor();
  }
  applyScheme(storedScheme() ?? (prefersLight.matches ? 'light' : 'dark'));
  schemeBtn.addEventListener('click', () => {
    const next = root.dataset.scheme === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem(SCHEME_KEY, next);
    } catch {}
    applyScheme(next);
  });
  prefersLight.addEventListener('change', (e) => {
    if (!storedScheme()) applyScheme(e.matches ? 'light' : 'dark');
  });

  // Normal / fun mode.
  const THEME_KEY = 'rc-theme';
  const themeBtn = document.querySelector('.nav__theme');
  function applyTheme(fun) {
    if (fun) root.dataset.theme = 'fun';
    else delete root.dataset.theme;
    themeBtn.setAttribute('aria-pressed', String(fun));
    syncThemeColor();
  }
  function storedFun() {
    try {
      return localStorage.getItem(THEME_KEY) === 'fun';
    } catch {
      return false;
    }
  }
  applyTheme(storedFun());
  themeBtn.addEventListener('click', () => {
    const fun = root.dataset.theme !== 'fun';
    try {
      localStorage.setItem(THEME_KEY, fun ? 'fun' : 'pro');
    } catch {}
    applyTheme(fun);
  });

  window.addEventListener('storage', (e) => {
    if (e.key === SCHEME_KEY) applyScheme(storedScheme() ?? (prefersLight.matches ? 'light' : 'dark'));
    if (e.key === THEME_KEY) applyTheme(e.newValue === 'fun');
  });
</script>
