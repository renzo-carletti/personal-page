---
import { profile, education, languages } from '../data/cv.js';
---

<section id="about" class="container">
  <div class="section-head reveal">
    <span class="kicker" data-i18n="about.kicker">// about</span>
    <h2 data-i18n="about.title" data-fun-fx="title">The engineer behind the stack</h2>
  </div>

  <div class="about__grid">
    <div class="glass about__card reveal" style="--d:.1s">
      <h3 class="about__card-title" data-i18n="about.who">Who I am</h3>
      <p data-i18n="hero.summary">{profile.summary}</p>
      <p data-i18n="about.whoText">
        My work sits at the intersection of content systems and fast, modern frontends. I take rigid,
        monolithic CMS platforms and turn them into decoupled, scalable, API-driven products.
      </p>
    </div>

    <div class="glass about__card reveal" style="--d:.2s">
      <h3 class="about__card-title" data-i18n="about.highlights-title">Highlights</h3>
      <ul class="about__highlights">
        {profile.highlights.map((h, i) => (
          <li data-i18n={`about.highlights.${i}`}>{h}</li>
        ))}
      </ul>
    </div>

    <div class="glass about__card reveal" style="--d:.3s">
      <h3 class="about__card-title" data-i18n="about.edu.title">Education</h3>
      <ul class="about__edu">
        {education.map((e, i) => (
          <li>
            <span class="about__edu-school" data-i18n={`about.edu.${i}.school`}>{e.school}</span>
            <span class="about__edu-degree" data-i18n={`about.edu.${i}.degree`}>{e.degree}</span>
            <span class="about__edu-meta" data-i18n={`about.edu.${i}.detail`}>{e.detail}</span>
            <span class="about__edu-period" data-i18n={`about.edu.${i}.period`}>{e.period}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="glass about__card reveal" style="--d:.4s">
      <h3 class="about__card-title" data-i18n="about.lang.title">Languages</h3>
      <ul class="about__langs">
        {languages.map((l, i) => (
          <li>
            <span class="about__lang-name">{l.name}</span>
            <span class="about__lang-level" data-i18n={`about.lang.${i}.level`}>{l.level}</span>
          </li>
        ))}
      </ul>
      <h3 class="about__card-title about__card-title--sub" data-i18n="about.current.title">Currently</h3>
      <p class="about__now" data-i18n="about.current.text">Drupal/Moodle Developer at UADER · open to remote Drupal + React opportunities</p>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
  }

  .about__card {
    padding: 1.8rem;
  }

  .about__card-title {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .about__card p + p {
    margin-top: 0.9rem;
  }

  .about__card p {
    color: var(--muted);
    font-size: 0.98rem;
  }

  .about__highlights {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .about__highlights li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .about__highlights li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--accent-2);
    font-family: var(--font-mono);
  }

  .about__edu {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .about__edu li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .about__edu-school {
    font-weight: 700;
  }

  .about__edu-degree,
  .about__edu-meta {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .about__edu-period {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent-2);
    margin-top: 0.2rem;
  }

  .about__langs {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-bottom: 1.6rem;
  }

  .about__langs li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px dashed var(--glass-border);
    padding-bottom: 0.5rem;
  }

  .about__lang-name {
    font-weight: 600;
  }

  .about__lang-level {
    color: var(--muted);
    font-size: 0.85rem;
    text-align: right;
  }

  .about__card-title--sub {
    margin-top: 1.6rem;
  }

  .about__now {
    font-size: 0.92rem;
  }

  @media (max-width: 820px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
  }
</style>