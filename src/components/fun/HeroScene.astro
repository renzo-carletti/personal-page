---
// Fun mode title screen: dusk sky, layered ridges (flat, no outlines) and Vivi on the ground.
// Hidden in normal mode by `.fun-only`.
import PixelSprite from './PixelSprite.astro';
import { bolt, chocobo, chocoRun, vivi } from './sprites.js';
import { translations } from '../../data/content.js';
import { farRidge, midRidge, hill3, hill4, hillLine, pines } from '../scene.js';
const en = translations.en;

const trees3 = pines(26, 7, hill3, [26, 48]);
const trees4 = pines(18, 42, hill4, [40, 72]);
const sparks = Array.from({ length: 8 });
---

<div class="fun-only fun-scene" aria-hidden="true">
  <svg class="fun-scene__land" viewBox="0 0 1440 420" preserveAspectRatio="xMidYMax slice" focusable="false">
    <circle cx="560" cy="250" r="96" fill="#fdb813" opacity="0.25" />
    <circle cx="560" cy="250" r="62" fill="#fdb813" />
    <path fill="#d9531e" d={`${farRidge}V420H0Z`} />
    <path fill="#8e2b1a" d={`${midRidge}V420H0Z`} />
    <path fill="#4a1620" d={`${hillLine(hill3)}V420H0Z${trees3}`} />
    <path fill="#1e0f22" d={`${hillLine(hill4)}V420H0Z${trees4}`} />
    <path fill="#0b0f1e" d="M0 400Q360 390 720 398T1440 396V420H0Z" />
  </svg>
</div>

<div class="fun-only fun-scene__fx" aria-hidden="true">
  <span class="fun-scene__flash"></span>
  <PixelSprite sprite={bolt} class="fun-scene__bolt" />
</div>

<!-- Each click casts the next spell: Fire, Blizzard, Thunder, Bio (fun-play.js). -->
<button class="fun-only vivi" type="button" aria-label={en['fun.vivi']} data-i18n="fun.vivi" data-i18n-attr="aria-label">
  <span class="vivi__bubble" aria-hidden="true">
    <span class="vivi__say vivi__say--fire" data-i18n="fun.cast">{en['fun.cast']}</span>
    <span class="vivi__say vivi__say--ice" data-i18n="fun.ice">{en['fun.ice']}</span>
    <span class="vivi__say vivi__say--bolt" data-i18n="fun.bolt">{en['fun.bolt']}</span>
    <span class="vivi__say vivi__say--bio" data-i18n="fun.bio">{en['fun.bio']}</span>
  </span>
  <span class="vivi__sparks" aria-hidden="true">{sparks.map(() => <span />)}</span>
  <PixelSprite sprite={vivi} class="vivi__sprite" />
</button>

<button class="fun-only choco" type="button" aria-label={en['fun.choco']} data-i18n="fun.choco" data-i18n-attr="aria-label">
  <span class="choco__bubble" aria-hidden="true" data-i18n="fun.kweh">{en['fun.kweh']}</span>
  <span class="choco__body">
    <PixelSprite sprite={chocobo} class="choco__sprite" />
    <PixelSprite sprite={chocoRun} class="choco__sprite choco__sprite--run" />
  </span>
  <span class="choco__dust" aria-hidden="true"><span /><span /><span /></span>
</button>
