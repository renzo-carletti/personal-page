---
import { skills, t, translations } from '../data/content.js';
const en = translations.en;
---

<section id="skills" class="section" aria-labelledby="skills-title">
  <div class="container section__grid">
    <header class="section__head">
      <span class="section__num">04</span>
      <span class="fun-only fun-label" aria-hidden="true" data-i18n="fun.skills">{en['fun.skills']}</span>
      <h2 id="skills-title" class="section__title" data-i18n="skills.title">{en['skills.title']}</h2>
    </header>

    <dl class="skills">
      {skills.map((group, gi) => (
        <div class="skills__group">
          <dt data-i18n={`skills.g${gi}`}>{t(group.group)}</dt>
          <dd>
            <ul class="skills__items" role="list">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-6);
  }

  .skills dt {
    font-weight: 600;
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-2);
    border-bottom: var(--border-1) solid var(--line);
  }

  .skills dd {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .skills__items li {
    display: inline;
  }

  .skills__items li:not(:last-child)::after {
    content: ', ';
  }

  @media print {
    .skills {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
  }
</style>
