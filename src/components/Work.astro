---
import Icon from './Icon.astro';
import { projects, t, translations } from '../data/content.js';
const en = translations.en;
const steps = ['problem', 'solution', 'impact'];
---

<section id="work" class="section" aria-labelledby="work-title">
  <div class="container section__grid">
    <header class="section__head">
      <span class="section__num">01</span>
      <h2 id="work-title" class="section__title" data-i18n="work.title">{en['work.title']}</h2>
      <p class="section__intro" data-i18n="work.intro">{en['work.intro']}</p>
    </header>

    <ol class="cases" role="list">
      {projects.map((p, i) => (
        <li class:list={['case', { 'case--featured': p.featured }]}>
          <article aria-labelledby={`case-${i}`}>
            <header class="case__head">
              <p class="label" data-i18n={`work.role.${p.role}`}>{en[`work.role.${p.role}`]}</p>
              <h3 id={`case-${i}`} class="case__name" data-i18n={`work.${i}.name`}>{t(p.name)}</h3>
              <p class="case__tagline" data-i18n={`work.${i}.tagline`}>{t(p.tagline)}</p>
              {p.metric && <p class="case__metric" data-i18n={`work.${i}.metric`}>{t(p.metric)}</p>}
            </header>

            <dl class="case__steps">
              {steps.map((k) => (
                <div>
                  <dt data-i18n={`case.${k}`}>{en[`case.${k}`]}</dt>
                  <dd data-i18n={`case.${i}.${k}`}>{t(p.case[k])}</dd>
                </div>
              ))}
            </dl>

            <footer class="case__foot">
              <div class="case__stack">
                <span class="visually-hidden" data-i18n="work.stack">{en['work.stack']}</span>
                <ul class="tags" role="list">
                  {p.tech.map((tag) => <li>{tag}</li>)}
                </ul>
              </div>
              <a class="link link--icon" href={p.url} target="_blank" rel="noopener noreferrer">
                <span data-i18n="work.visit">{en['work.visit']}</span>
                <Icon name="arrow-up-right" size={16} />
              </a>
            </footer>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .cases {
    display: grid;
    gap: var(--space-8);
  }

  .case + .case {
    padding-top: var(--space-8);
    border-top: var(--border-1) solid var(--line);
  }

  .case article {
    display: grid;
    gap: var(--space-5);
  }

  .case__name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    margin-top: var(--space-2);
  }

  .case--featured .case__name {
    font-size: var(--text-2xl);
  }

  .case__tagline {
    color: var(--muted);
    margin-top: var(--space-1);
  }

  .case__metric {
    display: inline-block;
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
  }

  .case__steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-5);
  }

  .case__steps dt {
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  .case__steps dd {
    color: var(--muted);
  }

  .case__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
</style>
