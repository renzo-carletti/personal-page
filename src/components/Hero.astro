---
import { profile, stats, siteConfig } from '../data/cv.js';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section id="top" class="hero">
  <canvas id="hero-canvas" class="hero__canvas" aria-hidden="true"></canvas>

  <span class="hero__spark hero__spark--1" aria-hidden="true"></span>
  <span class="hero__spark hero__spark--2" aria-hidden="true"></span>

  <div class="hero__ow" aria-hidden="true">
    <div class="hero__planet">
      <span class="hero__planet-body"></span>
      <span class="hero__planet-ring"></span>
      <span class="hero__planet-moon"></span>
    </div>
  </div>

  <div class="hero__crystal" aria-hidden="true">
    <svg viewBox="0 0 100 120">
      <path d="M50 2 L60 22 L82 44 L72 78 L50 112 L28 78 L18 44 L40 22 Z" fill="url(#cry1)" stroke="#e8b64c" stroke-width="1.4" stroke-linejoin="round" />
      <path d="M50 2 L40 22 L18 44 L50 50 Z" fill="url(#cry2)" />
      <path d="M50 2 L60 22 L82 44 L50 50 Z" fill="url(#cry3)" />
      <path d="M18 44 L50 50 L28 78 Z" fill="url(#cry4)" />
      <path d="M82 44 L50 50 L72 78 Z" fill="url(#cry5)" />
      <path d="M50 50 L28 78 L50 112 Z" fill="url(#cry6)" />
      <path d="M50 50 L72 78 L50 112 Z" fill="url(#cry1)" opacity="0.85" />
      <defs>
        <linearGradient id="cry1" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#c98f26" />
          <stop offset="0.55" stop-color="#f8d46a" />
          <stop offset="1" stop-color="#7a4a10" />
        </linearGradient>
        <linearGradient id="cry2" x1="0" y1="1" x2="1" y2="0">
          <stop offset="0" stop-color="#5a3209" />
          <stop offset="1" stop-color="#c98f26" />
        </linearGradient>
        <linearGradient id="cry3" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#fff6d0" />
          <stop offset="1" stop-color="#e8b64c" />
        </linearGradient>
        <linearGradient id="cry4" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#c98f26" />
          <stop offset="1" stop-color="#7a4a10" />
        </linearGradient>
        <linearGradient id="cry5" x1="1" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#f8d46a" />
          <stop offset="1" stop-color="#a06a18" />
        </linearGradient>
        <linearGradient id="cry6" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#e8b64c" />
          <stop offset="1" stop-color="#5a3209" />
        </linearGradient>
      </defs>
    </svg>
  </div>

  <div class="container hero__inner">
    <p class="hero__hello reveal" style="--d:.05s" data-i18n="hero.hello">Hi, I'm</p>
    <h1 class="hero__name reveal" data-fun-fx="hero" style="--d:.15s">
      Renzo
      <span class="hero__name-accent">Carletti</span>
    </h1>
    <p class="hero__role reveal" style="--d:.25s">
      <span class="hero__role-prefix">$ whoami:</span>
      <span id="role-rotator" class="hero__role-text" data-i18n-roles data-roles={JSON.stringify(profile.roles)}>Decoupled Drupal & React Engineer</span>
      <span class="hero__role-cursor" aria-hidden="true">▍</span>
    </p>
    <p class="hero__desc reveal" style="--d:.35s" data-i18n="hero.summary">{profile.summary}</p>

    <div class="hero__actions reveal" style="--d:.45s">
      <a
        class="btn btn--primary"
        href={siteConfig.booking || '#contact'}
        target={siteConfig.booking ? '_blank' : undefined}
        rel={siteConfig.booking ? 'noopener noreferrer' : undefined}
        data-i18n="hero.letstalk"
      >Let's talk</a>
      <a class="btn btn--ghost" href={base + 'cv.pdf'} data-i18n="hero.download" download>Download CV</a>
    </div>

    <div class="hero__socials reveal" style="--d:.55s">
      <span class="hero__bilingual" data-i18n="hero.bilingual">Bilingual · EN / ES</span>
      <span class="hero__open"><span class="hero__open-dot" aria-hidden="true"></span><span data-i18n="hero.open">Open to work</span></span>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">LinkedIn</a>
      <a href={profile.email} aria-label="Email">Email</a>
      <a href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">GitHub</a>
    </div>
  </div>

  <div class="hero__stats container reveal" style="--d:.65s">
    {stats.map((s, i) => (
      <div class="glass hero__stat" style={`--i:${i}`}>
        <span class="hero__stat-value" data-count={s.value} data-suffix={s.suffix}>0{s.suffix}</span>
        <span class="hero__stat-label" data-i18n={`hero.stats.${s.id}`}>{s.label}</span>
      </div>
    ))}
  </div>

  <a class="hero__scroll" href="#about" aria-label="Scroll to about">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 5v14M19 12l-7 7-7-7" />
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 8rem 4rem;
    overflow: hidden;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
  }

  .hero__hello {
    font-family: var(--font-mono);
    color: var(--accent-2);
    font-size: 1rem;
    margin-bottom: 0.6rem;
  }

  .hero__name {
    font-size: clamp(3rem, 9vw, 5.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.02;
    background: linear-gradient(110deg, #fff 30%, color-mix(in srgb, var(--accent-1) 60%, #fff));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero__name-accent {
    background: linear-gradient(110deg, var(--accent-1), var(--accent-3));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero__role {
    margin-top: 1.4rem;
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2.6vw, 1.35rem);
    color: var(--muted);
    min-height: 2.2em;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  @media (max-width: 720px) {
    .hero__role {
      min-height: 3.4em;
    }
  }

  .hero__role-prefix {
    color: var(--accent-1);
  }

  .hero__role-cursor {
    color: var(--accent-2);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .hero__desc {
    margin-top: 1.2rem;
    max-width: 60ch;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .hero__actions {
    margin-top: 2.2rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero__socials {
    margin-top: 2.4rem;
    display: flex;
    align-items: center;
    gap: 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    flex-wrap: wrap;
  }

  .hero__open {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    font-size: 0.78rem;
    color: #7cf7b8;
    background: rgba(124, 247, 184, 0.08);
    border: 1px solid rgba(124, 247, 184, 0.25);
  }

  .hero__bilingual {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    font-size: 0.78rem;
    color: var(--accent-2);
    background: color-mix(in srgb, var(--accent-2) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-2) 30%, transparent);
  }

  .hero__open-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    animation: pulse 2.2s var(--ease) infinite;
  }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.5); }
    50% { box-shadow: 0 0 0 6px rgba(74, 222, 128, 0); }
  }

  .hero__socials a {
    color: var(--muted);
    border-bottom: 1px solid var(--glass-border);
    padding-bottom: 2px;
    transition: color 0.25s, border-color 0.25s;
  }

  .hero__socials a:hover {
    color: var(--accent-2);
    border-color: var(--accent-2);
  }

  .hero__stats {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 4.5rem;
  }

  .hero__stat {
    min-width: 0;
    padding: 1.2rem 1.4rem;
    text-align: center;
  }

  .hero__stat-value {
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 700;
    background: linear-gradient(120deg, var(--accent-2), var(--accent-1));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .hero__stat-label {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.8rem;
    color: var(--faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .hero__scroll {
    position: absolute;
    bottom: 1.2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    color: var(--muted);
    animation: bob 2s ease-in-out infinite;
    transition: color 0.25s;
  }

  .hero__scroll:hover {
    color: var(--accent-2);
  }

  .hero__spark {
    display: none;
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffe9a8 0%, #ffd93d 45%, transparent 75%);
    z-index: 1;
    opacity: 0.75;
  }

  html[data-theme='fun'] .hero__ow {
    display: block !important;
  }

  html[data-theme='fun'] .hero__spark {
    display: block !important;
  }

  .hero__spark--1 {
    right: 22vw;
    bottom: 62vh;
    animation: spark-float 5s ease-in-out infinite;
  }

  .hero__spark--2 {
    right: 16vw;
    bottom: 45vh;
    animation: spark-float 6.5s ease-in-out 1.2s infinite;
  }

  @keyframes spark-float {
    0%, 100% { transform: translateY(0); opacity: 0.3; }
    50% { transform: translateY(-14px); opacity: 0.85; }
  }

  /* Timber Hearth-ish planet (Outer Wilds) */
  .hero__ow {
    display: none;
    position: absolute;
    right: clamp(1rem, 8vw, 7rem);
    top: 13vh;
    width: clamp(70px, 7vw, 92px);
    aspect-ratio: 1;
    z-index: 1;
  }

  html[data-theme='fun'] .hero__ow {
    display: block !important;
  }

  .hero__planet {
    position: relative;
    width: 100%;
    height: 100%;
    animation: planet-drift 9s ease-in-out infinite;
  }

  .hero__planet-body {
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 30%, #9ad66f 0%, #3f8f4e 42%, #1e5a36 100%);
    box-shadow: 0 0 18px rgba(90, 200, 120, 0.28);
  }

  .hero__planet-ring {
    position: absolute;
    inset: 22% -14% 22% -14%;
    border-radius: 50%;
    border: 3px solid rgba(240, 220, 170, 0.8);
    transform: rotate(-24deg) scaleX(0.62);
  }

  .hero__planet-moon {
    position: absolute;
    top: 6%;
    right: 2%;
    width: 22%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 34% 30%, #e8d9b0, #b58a4f 70%);
    animation: moon-orbit 14s linear infinite;
    transform-origin: -320% 320%;
  }

  @keyframes planet-drift {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-12px) rotate(2deg); }
  }

  @keyframes moon-orbit {
    to { transform: rotate(360deg); }
  }

  /* FF9 garnet crystal */
  .hero__crystal {
    display: none;
    position: absolute;
    left: clamp(1rem, 6vw, 5rem);
    bottom: 24vh;
    width: clamp(46px, 5vw, 64px);
    z-index: 1;
    filter: drop-shadow(0 0 14px rgba(248, 212, 106, 0.45));
    animation: crystal-bob 7s ease-in-out infinite;
  }

  html[data-theme='fun'] .hero__crystal {
    display: block !important;
  }

  @keyframes crystal-bob {
    0%, 100% { transform: translateY(0) rotate(-3deg); }
    50% { transform: translateY(-10px) rotate(3deg); }
  }

  @media (max-width: 720px), (max-height: 720px) {
    .hero__spark,
    .hero__ow,
    .hero__crystal {
      display: none !important;
    }
  }

  @media (max-width: 1000px) {
    .hero__ow,
    .hero__crystal {
      display: none !important;
    }
  }

  @keyframes bob {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 8px); }
  }

  @media (max-width: 820px) {
    .hero__scroll {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .hero__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hero__stats .hero__stat:nth-child(5) {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let roles = JSON.parse(document.getElementById('role-rotator').dataset.roles);
  let roleIndex = 0;
  let roleChar = 0;
  let deleting = false;
  const el = document.getElementById('role-rotator');

  function type() {
    const current = roles[roleIndex];
    if (!deleting) {
      roleChar++;
      el.textContent = current.slice(0, roleChar);
      if (roleChar === current.length) {
        deleting = true;
        setTimeout(type, 2000);
        return;
      }
      setTimeout(type, 55 + Math.random() * 40);
    } else {
      roleChar--;
      el.textContent = current.slice(0, roleChar);
      if (roleChar === 0) {
        deleting = false;
        roleIndex = (roleIndex + 1) % roles.length;
        setTimeout(type, 400);
        return;
      }
      setTimeout(type, 30);
    }
  }

  function restartTyping() {
    roleIndex = 0;
    roleChar = 0;
    deleting = false;
    el.textContent = '';
    if (reducedMotion) {
      el.textContent = roles[0];
    } else {
      type();
    }
  }

  if (!reducedMotion) type();

  window.addEventListener('i18n:changed', () => {
    roles = JSON.parse(el.dataset.roles);
    restartTyping();
  });

  const counters = document.querySelectorAll('[data-count]');
  if (reducedMotion) {
    counters.forEach((c) => (c.textContent = c.dataset.count + c.dataset.suffix));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target;
          io.unobserve(el);
          const target = parseInt(el.dataset.count, 10);
          const suffix = el.dataset.suffix;
          const dur = 1400;
          const start = performance.now();
          const tick = (now) => {
            const p = Math.min((now - start) / dur, 1);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = Math.round(target * eased) + suffix;
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      },
      { threshold: 0.5 }
    );
    counters.forEach((c) => io.observe(c));
  }

  if (!reducedMotion) {
    import('../scripts/hero-three.js').then((m) => m.initHeroCanvas('hero-canvas'));
  }
</script>