---
import { profile, translations } from '../data/content.js';
const en = translations.en;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <p>© {year} {profile.name}. <span data-i18n="footer.built">{en['footer.built']}</span></p>
    <ul class="footer__links" role="list">
      <li><a class="link" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      <li><a class="link" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
      <li><a class="link" href={`mailto:${profile.email}`}>Email</a></li>
      <li><a class="link" href={base + 'cv.pdf'} download>CV (PDF)</a></li>
    </ul>
    <p class="fun-only footer__credit" data-i18n="fun.credit">{en['fun.credit']}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: var(--border-1) solid var(--line);
    /* Room for the fixed back-to-top button. */
    padding-block: var(--space-6) var(--space-9);
    font-size: var(--text-sm);
    color: var(--faint);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  @media print {
    .footer {
      display: none;
    }
  }
</style>
