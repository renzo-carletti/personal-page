---
// Page-wide fun mode layers: pixel starfield behind everything and the airship
// that follows scroll progress (`--scroll`, set in scroll-ui.js).
import PixelSprite from './PixelSprite.astro';
import { airship, campfire, sun } from './sprites.js';
import { translations } from '../../data/content.js';
const en = translations.en;
import QuantumMoon from './QuantumMoon.astro';

function stars(count: number, seed: number, size: number) {
  let s = seed;
  const rand = () => ((s = (s * 9301 + 49297) % 233280) / 233280);
  return Array.from({ length: count }, () => `M${Math.floor(rand() * 240)} ${Math.floor(rand() * 240)}h${size}v${size}h-${size}z`).join('');
}
---

<div class="fun-only fun-sky" aria-hidden="true">
  <svg width="100%" height="100%" focusable="false">
    <defs>
      <pattern id="stars-a" width="240" height="240" patternUnits="userSpaceOnUse">
        <path d={stars(22, 3, 2)} fill="#b9bcc8" opacity="0.55" />
        <path d={stars(4, 11, 3)} fill="#fff4d6" />
      </pattern>
      <pattern id="stars-b" x="120" y="60" width="240" height="240" patternUnits="userSpaceOnUse">
        <path d={stars(6, 29, 2)} fill="#fff4d6" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#stars-a)" />
    <rect class="fun-sky__twinkle" width="100%" height="100%" fill="url(#stars-b)" />
  </svg>
</div>

<!-- Achievement pop-up (fun-secrets.js) and the supernova sequence (fun-play.js). -->
<div class="fun-only toast" role="status" aria-live="polite">
  <p class="toast__title"></p>
  <p class="toast__text"></p>
</div>
<!-- Supernova: the sun swells and collapses, a blue shockwave, white-out, black silence
     by the campfire, then the eyes blink open on the page again. Skipped with reduced motion. -->
<div class="fun-only nova" aria-hidden="true">
  <PixelSprite sprite={sun} class="nova__sun" />
  <span class="nova__ring"></span>
  <span class="nova__ring nova__ring--late"></span>
  <span class="nova__white"></span>
  <span class="nova__black">
    <PixelSprite sprite={campfire} class="nova__fire" />
    <span class="nova__text" data-i18n="fun.nova.loop">{en['fun.nova.loop']}</span>
  </span>
  <span class="nova__lid nova__lid--top"></span>
  <span class="nova__lid nova__lid--bottom"></span>
</div>
<QuantumMoon />

<!-- Black hole (fun-blackhole.js): the disk opens where the sun was, the page falls in, then the
     Dark Souls death screen and the eyes open on a new loop. -->
<div class="fun-only blackhole" aria-hidden="true">
  <span class="blackhole__disk"></span>
  <span class="blackhole__hole"></span>
  <span class="blackhole__dark"></span>
  <span class="blackhole__lid blackhole__lid--top"></span>
  <span class="blackhole__lid blackhole__lid--bottom"></span>
</div>

<!-- Dark Souls banner: "BONFIRE LIT" (gold) and "YOU DIED" (red). -->
<div class="fun-only souls-banner" aria-hidden="true"><span class="souls-banner__text"></span></div>

<!-- Cheat book (fun-cheats.js): a card per cheat, learned ones ready to use, missing ones with a hint. -->
<div id="cheats" class="fun-only cheatbook" role="dialog" aria-modal="true" aria-labelledby="cheatbook-title" hidden>
  <div class="cheatbook__window">
    <header class="cheatbook__head">
      <h2 id="cheatbook-title" class="cheatbook__title" data-i18n="fun.cheats.title">{en['fun.cheats.title']}</h2>
      <p class="cheatbook__progress"></p>
      <button class="cheatbook__close" type="button" aria-label={en['fun.cheats.close']} data-i18n="fun.cheats.close" data-i18n-attr="aria-label">✕</button>
    </header>
    <ul class="cheatbook__list" role="list"></ul>
    <form class="cheatbook__form">
      <label for="cheat-input" data-i18n="fun.cheats.label">{en['fun.cheats.label']}</label>
      <div class="cheatbook__row">
        <input id="cheat-input" name="cheat" type="text" list="cheat-known" autocomplete="off" spellcheck="false" autocapitalize="off" />
        <button class="btn" type="submit" data-i18n="fun.cheats.enter">{en['fun.cheats.enter']}</button>
      </div>
      <datalist id="cheat-known"></datalist>
      <p class="cheats__out" role="status" aria-live="polite"></p>
    </form>
  </div>
</div>

<div class="fun-only airship" aria-hidden="true">
  <PixelSprite sprite={airship} class="airship__sprite" />
</div>
