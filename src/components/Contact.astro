---
import { profile, siteConfig } from '../data/cv.js';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section id="contact" class="container">
  <div class="glass contact reveal">
    <div class="contact__info">
      <span class="kicker" data-i18n="contact.kicker">// contact</span>
      <h2 data-i18n="contact.title" data-fun-fx="title">Let's build something fast together</h2>
      <p data-i18n="contact.text">
        Got a headless CMS project, a legacy platform to modernize, or just want to talk shop about
        Drupal, React and APIs? My inbox is open.
      </p>
      <div class="contact__links">
        <a href={`mailto:${profile.email}`} class="contact__link">
          <span class="contact__link-label" data-i18n="contact.email">Email</span>
          <span class="contact__link-value">{profile.email}</span>
        </a>
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="contact__link">
          <span class="contact__link-label" data-i18n="contact.linkedin">LinkedIn</span>
          <span class="contact__link-value">in/renzo-emiliano-carletti</span>
        </a>
        <a href={`tel:${profile.phone.replace(/\s/g, '')}`} class="contact__link">
          <span class="contact__link-label" data-i18n="contact.phone">Phone</span>
          <span class="contact__link-value">{profile.phone}</span>
        </a>
      </div>
      <a class="btn btn--ghost" href={base + 'cv.pdf'} data-i18n="nav.download" download>Download CV</a>
    </div>

    <form id="contact-form" class="contact__form" data-email={profile.email} data-form-key={siteConfig.web3FormsKey}>
      <label class="field">
        <span data-i18n="contact.form.name">Name</span>
        <input type="text" name="name" required placeholder="Your name" autocomplete="name" data-i18n-attr="placeholder" data-i18n="contact.form.namePh" />
      </label>
      <label class="field">
        <span data-i18n="contact.form.email">Email</span>
        <input type="email" name="email" required placeholder="you@company.com" autocomplete="email" data-i18n-attr="placeholder" data-i18n="contact.form.emailPh" />
      </label>
      <label class="field">
        <span data-i18n="contact.form.subject">Subject</span>
        <input type="text" name="subject" required placeholder="What's this about?" data-i18n-attr="placeholder" data-i18n="contact.form.subjectPh" />
      </label>
      <label class="field">
        <span data-i18n="contact.form.message">Message</span>
        <textarea name="message" rows="5" required placeholder="Tell me about your project..." data-i18n-attr="placeholder" data-i18n="contact.form.messagePh"></textarea>
      </label>
      <div class="contact__actions">
        <button type="submit" class="btn btn--primary contact__submit" data-i18n="contact.submit">Send message</button>
        <button type="button" id="copy-msg" class="btn btn--ghost contact__copy" hidden data-i18n="contact.copy">Copy message</button>
      </div>
      <p class="contact__hint" role="status" aria-live="polite" data-i18n="contact.hint">
        Messages go straight to my inbox. No account or sign-up needed.
      </p>
      {siteConfig.booking && (
        <p class="contact__book">
          <a href={siteConfig.booking} target="_blank" rel="noopener noreferrer" data-i18n="contact.book">
            Prefer to book directly? Open my 15-minute call calendar.
          </a>
        </p>
      )}
    </form>
  </div>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    padding: 2.5rem;
  }

  .contact__info p {
    color: var(--muted);
    margin-top: 1rem;
    max-width: 42ch;
  }

  .contact__links {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 1.8rem 0;
  }

  .contact__link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.7rem 0.2rem;
    border-bottom: 1px solid var(--glass-border);
    transition: border-color 0.25s;
  }

  .contact__link:hover {
    border-color: color-mix(in srgb, var(--accent-2) 50%, transparent);
  }

  .contact__link-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--faint);
  }

  .contact__link-value {
    font-size: 0.92rem;
    color: var(--text);
    word-break: break-word;
    text-align: right;
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field span {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--faint);
  }

  .field input,
  .field textarea {
    font: inherit;
    color: var(--text);
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-sm);
    padding: 0.8rem 1rem;
    transition: border-color 0.25s, background 0.25s;
    resize: vertical;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent-2);
    background: var(--glass-strong);
  }

  .contact__submit {
    align-self: flex-start;
  }

  .contact__actions {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 0.3rem;
  }

  .contact__copy[hidden] {
    display: none;
  }

  .contact__hint {
    font-size: 0.78rem;
    color: var(--faint);
  }

  .contact__book {
    margin-top: 0.6rem;
    font-size: 0.82rem;
  }

  .contact__book a {
    color: var(--accent-2);
    border-bottom: 1px solid color-mix(in srgb, var(--accent-2) 40%, transparent);
    transition: border-color 0.25s;
  }

  .contact__book a:hover {
    border-color: var(--accent-2);
  }

  @media (max-width: 860px) {
    .contact {
      grid-template-columns: 1fr;
      padding: 1.8rem;
    }
  }
</style>

<script>
  import { currentLang } from '../scripts/i18n.js';
  import { translations, defaultLang } from '../i18n/translations.js';

  const form = document.getElementById('contact-form');
  const status = document.querySelector('.contact__hint');
  const copyBtn = document.getElementById('copy-msg');
  const email = form.dataset.email;
  const formKey = form.dataset.formKey;

  const t = (key) => (translations[currentLang()] ?? translations[defaultLang])[key];

  let lastBody = '';

  function setStatus(key, extra = '') {
    status.textContent = (t(key) ?? '') + extra;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const el = (n) => form.elements.namedItem(n);
    const name = el('name').value.trim();
    const from = el('email').value.trim();
    const subjectLine = el('subject').value.trim();
    const message = el('message').value.trim();

    const subject = `[Portfolio] ${subjectLine}`;
    const body = `Name: ${name}\nEmail: ${from}\n\n${message}`;
    lastBody = body;

    copyBtn.hidden = false;

    if (formKey) {
      setStatus('contact.sending');
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: formKey,
            subject,
            from_name: name,
            from_email: from,
            message,
          }),
        });
        const json = await res.json();
        if (json.success) {
          setStatus('contact.success');
          form.reset();
          copyBtn.hidden = true;
          return;
        }
        throw new Error(json.message || 'error');
      } catch {
        // fall back to email client
        window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        setStatus('contact.opening', email);
        return;
      }
    }

    window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    setStatus('contact.opening', email);
  });

  copyBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(lastBody);
      setStatus('contact.copied');
    } catch {
      setStatus('contact.copyFail');
    }
  });
</script>