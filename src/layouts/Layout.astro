---
import { fontCss, newsLatin, publicLatin } from '../styles/fonts.js';
import '../styles/global.css';
import '../styles/fun.css';
import Nav from '../components/Nav.astro';
import Icon from '../components/Icon.astro';
import ThemeInit from '../components/ThemeInit.astro';
import FunLayer from '../components/fun/FunLayer.astro';
import { profile, t, translations } from '../data/content.js';
const en = translations.en;

const { title = en['meta.title'] } = Astro.props;

const siteUrl = Astro.site!.href.replace(/\/$/, '');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');


const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: t(profile.role),
  email: `mailto:${profile.email}`,
  telephone: profile.phone.replace(/\s/g, ''),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Paraná',
    addressRegion: 'Entre Ríos',
    addressCountry: 'AR',
  },
  url: siteUrl,
  sameAs: [profile.linkedin, profile.github],
  knowsAbout: [
    'React.js', 'Drupal', 'Moodle', 'REST APIs', 'JSON:API', 'OAuth2',
    'PHP', 'Headless CMS', 'DevOps', 'Docker', 'Kubernetes', 'AWS',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={en['meta.description']} data-i18n="meta.description" data-i18n-attr="content" />
    <meta name="keywords" content="Drupal developer, Drupal upgrades, Drupal migration, Decoupled Drupal, Headless CMS, React, JSON:API, REST APIs, GraphQL, Moodle, PHP, Argentina" />
    <meta name="author" content="Renzo Emiliano Carletti" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#101214" />
    <meta name="color-scheme" content="dark light" />
    <ThemeInit />
    <link rel="icon" type="image/svg+xml" href={base + 'favicon.svg'} />
    <link rel="apple-touch-icon" href={base + 'apple-touch-icon.png'} />
    <link rel="canonical" href={siteUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={en['meta.description']} />
    <meta property="og:image" content={`${siteUrl}/og.png`} />
    <meta property="og:site_name" content="Renzo Carletti" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${siteUrl}/og.png`} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={en['meta.description']} />

    <title data-i18n="meta.title">{title}</title>

    <link rel="preload" href={publicLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={newsLatin} as="font" type="font/woff2" crossorigin />

    <style is:global set:html={fontCss} />
  </head>
  <body>
    <a class="skip-link" href="#main" data-i18n="nav.skip">{en['nav.skip']}</a>
    <FunLayer />
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
    <button id="back-to-top" class="back-to-top" aria-label={en['footer.top']} data-i18n="footer.top" data-i18n-attr="aria-label">
      <Icon name="arrow-up" />
    </button>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script>
      import '../scripts/scroll-ui.js';
      import '../scripts/fun-play.js';
    </script>
  </body>
</html>