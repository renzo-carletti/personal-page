---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import HeroScene from './fun/HeroScene.astro';
import { farRidge, midRidge, hill3, hillLine } from './scene.js';
import { profile, stats, t, translations } from '../data/content.js';
const en = translations.en;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Optional: the hero shows the portrait only if src/assets/portrait.jpg exists.
const portrait = Object.values(import.meta.glob<{ default: ImageMetadata }>('../assets/portrait.jpg', { eager: true }))[0]?.default;
---

<section id="top" class:list={['hero container', { 'hero--portrait': portrait }]} aria-labelledby="hero-name">
  <svg class="pro-only hero__ridges" viewBox="0 196 1440 224" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path class="hero__ridge" d={farRidge} pathLength="1" />
    <path class="hero__ridge hero__ridge--accent" d={midRidge} pathLength="1" />
    <path class="hero__ridge" d={hillLine(hill3)} pathLength="1" />
  </svg>
  {portrait && (
    <figure class="pro-only hero__portrait">
      <Picture
        src={portrait}
        alt={en['hero.portrait']}
        data-i18n="hero.portrait"
        data-i18n-attr="alt"
        formats={['avif', 'webp']}
        widths={[240, 480, 720]}
        sizes="(min-width: 960px) 240px, 112px"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  )}
  <div class="hero__main">
    <p class="pro-only hero__status">
      <span class="hero__dot" aria-hidden="true"></span>
      <span data-i18n="hero.available">{en['hero.available']}</span>
    </p>
    <p class="hero__role" data-i18n="hero.role">{t(profile.role)}</p>
    <h1 id="hero-name" class="hero__name">{profile.name}</h1>
    <p class="hero__tagline" data-i18n="hero.tagline">{t(profile.tagline)}</p>
    <p class="hero__summary" data-i18n="hero.summary">{t(profile.summary)}</p>

    <div class="hero__actions">
      <a class="fun-only btn btn--start" href="#work" data-i18n="fun.start">{en['fun.start']}</a>
      <a class="btn btn--primary" href="#contact">
        <Icon name="mail" size={16} />
        <span data-i18n="hero.contact">{en['hero.contact']}</span>
      </a>
      <a class="btn btn--ghost" href={base + 'renzo-carletti-cv.pdf'} download data-cv>
        <Icon name="download" size={16} />
        <span data-i18n="hero.download">{en['hero.download']}</span>
      </a>
    </div>
  </div>

  <aside class="hero__aside" aria-labelledby="hero-facts">
    <h2 id="hero-facts" class="label" data-i18n="hero.facts">{en['hero.facts']}</h2>
    <dl class="hero__facts">
      <div>
        <dt data-i18n="hero.based">{en['hero.based']}</dt>
        <dd data-i18n="hero.basedValue">{en['hero.basedValue']}</dd>
      </div>
      <div>
        <dt data-i18n="hero.now">{en['hero.now']}</dt>
        <dd data-i18n="about.current.text">{t(profile.current)}</dd>
      </div>
      <div>
        <dt data-i18n="hero.langs">{en['hero.langs']}</dt>
        <dd data-i18n="hero.langsValue">{en['hero.langsValue']}</dd>
      </div>
    </dl>
    <ul class="hero__links" role="list">
      <li><a class="link link--icon" href={profile.linkedin} target="_blank" rel="noopener noreferrer" data-print-url="false"><Icon name="linkedin" size={16} />LinkedIn</a></li>
      <li><a class="link link--icon" href={profile.github} target="_blank" rel="noopener noreferrer" data-print-url="false"><Icon name="github" size={16} />GitHub</a></li>
      <li><a class="link link--icon" href={`mailto:${profile.email}`}><Icon name="mail" size={16} />{profile.email}</a></li>
    </ul>
  </aside>

  <dl class="hero__numbers" aria-label={en['hero.numbers']} data-i18n="hero.numbers" data-i18n-attr="aria-label">
    {stats.map((s) => (
      <div>
        <dt data-i18n={`hero.stats.${s.id}`}>{t(s.label)}</dt>
        <dd data-i18n={`hero.stats.${s.id}.value`}>{en[`hero.stats.${s.id}.value`]}</dd>
      </div>
    ))}
  </dl>
  <!-- Last in the DOM so Vivi comes after the hero actions in tab order. -->
  <HeroScene />
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    padding-block: var(--space-8) calc(var(--space-9) + clamp(70px, 9vw, 130px));
  }

  /* Line-art echo of the fun mode landscape, full bleed under the hero. */
  .hero__ridges {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 100vw;
    max-width: none;
    height: clamp(90px, 11vw, 160px);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .hero__ridge {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
  }

  .hero__ridge--accent {
    stroke: var(--accent);
    opacity: 0.55;
  }

  /* The ridges draw in once on load, back to front. */
  .hero__ridge {
    stroke-dasharray: 1;
    animation: ridge-draw 1.8s var(--ease) 0.2s both;
  }

  .hero__ridge--accent {
    animation-delay: 0.45s;
  }

  .hero__ridge:last-child {
    animation-delay: 0.7s;
  }

  @keyframes ridge-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Portrait: a sober frame with an accent outline offset behind it. */
  .hero__portrait {
    position: relative;
    width: 7rem;
    margin-bottom: calc(var(--space-5) - var(--space-7));
  }

  .hero__portrait::before {
    content: '';
    position: absolute;
    inset: 0;
    transform: translate(6px, 6px);
    border: var(--border-1) solid var(--accent);
    border-radius: var(--radius-sm);
  }

  .hero__portrait :global(img) {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 50% 15%;
    background: var(--surface);
    border: var(--border-1) solid var(--line-strong);
    border-radius: var(--radius-sm);
  }

  /* Portrait and quick facts settle in once on load (normal mode). */
  :global(:root:not([data-theme='fun'])) :is(.hero__portrait, .hero__aside) {
    animation: hero-in 0.7s var(--ease) 0.15s both;
  }

  :global(:root:not([data-theme='fun'])) .hero__aside {
    animation-delay: 0.3s;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    color: var(--muted);
    border: var(--border-1) solid var(--line);
    border-radius: var(--radius-pill);
  }

  .hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--success) 25%, transparent);
  }

  @media (min-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      column-gap: var(--space-8);
      padding-top: var(--space-9);
    }
  }

  .hero__role {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
    margin-bottom: var(--space-4);
  }

  .hero__name {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .hero__tagline {
    margin-top: var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    line-height: var(--leading-snug);
    max-width: 30ch;
  }

  .hero__summary {
    margin-top: var(--space-5);
    color: var(--muted);
    max-width: var(--measure);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .hero__aside {
    align-self: end;
    padding-top: var(--space-5);
    border-top: var(--border-1) solid var(--line);
  }

  @media (min-width: 960px) {
    .hero__aside {
      border-top: none;
      padding-top: 0;
      padding-left: var(--space-6);
      border-left: var(--border-1) solid var(--line);
    }

    /* With the portrait: it sits at the top of the right column, quick facts below it. */
    :global(:root:not([data-theme='fun'])) .hero--portrait {
      row-gap: 0;
    }

    :global(:root:not([data-theme='fun'])) .hero--portrait .hero__main {
      grid-row: 1 / span 2;
    }

    .hero__portrait {
      grid-column: 2;
      grid-row: 1;
      width: 15rem;
      margin: 0 0 var(--space-6) calc(var(--space-6) + var(--border-1));
    }

    .hero__portrait::before {
      transform: translate(8px, 8px);
    }

    .hero__portrait :global(img) {
      aspect-ratio: 4 / 5;
      object-position: 50% 0;
    }

    :global(:root:not([data-theme='fun'])) .hero--portrait .hero__aside {
      grid-column: 2;
      grid-row: 2;
    }

    :global(:root:not([data-theme='fun'])) .hero--portrait .hero__numbers {
      margin-top: var(--space-7);
    }
  }

  .hero__facts {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .hero__facts dt {
    font-size: var(--text-sm);
    color: var(--faint);
  }

  .hero__facts dd {
    font-size: var(--text-sm);
  }

  .hero__links {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-5);
    font-size: var(--text-sm);
  }

  .hero__links .link {
    word-break: break-word;
  }

  .hero__numbers {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    border-top: var(--border-1) solid var(--line);
  }

  .hero__numbers > div {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-5) var(--space-5) 0 0;
  }

  /* Short accent rule above each number. */
  .hero__numbers > div::before {
    content: '';
    order: -2;
    width: 1.5rem;
    height: 2px;
    margin-bottom: var(--space-3);
    background: var(--accent);
  }

  .hero__numbers dd {
    order: -1;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-variant-numeric: lining-nums tabular-nums;
    line-height: 1;
  }

  .hero__numbers dt {
    font-size: var(--text-sm);
    color: var(--muted);
    max-width: 22ch;
  }

  @media print {
    .hero {
      padding-block: 0 1rem;
      gap: 1rem;
    }

    .hero__actions,
    .hero__ridges,
    .hero__status {
      display: none;
    }

    .hero__portrait {
      width: 5.5rem;
      margin: 0;
      animation: none;
    }

    .hero__portrait::before {
      content: none;
    }

    .hero__name {
      font-size: 2.4rem;
    }

    .hero__numbers dd {
      font-size: 1.4rem;
    }
  }
</style>
