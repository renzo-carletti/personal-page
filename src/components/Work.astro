---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { projects, t, translations } from '../data/content.js';
const en = translations.en;
const steps = ['problem', 'solution', 'impact'];

const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/work/*.webp', { eager: true });
const shot = (id: string) => shots[`../assets/work/${id}.webp`]?.default;
const host = (url: string) => new URL(url).host.replace(/^www\./, '');
---

<section id="work" class="section" aria-labelledby="work-title">
  <div class="container section__grid">
    <header class="section__head">
      <span class="section__num">01</span>
      <span class="fun-only fun-label" aria-hidden="true" data-i18n="fun.work">{en['fun.work']}</span>
      <h2 id="work-title" class="section__title" data-i18n="work.title">{en['work.title']}</h2>
      <p class="section__intro" data-i18n="work.intro">{en['work.intro']}</p>
    </header>

    <ol class="cases" role="list">
      {projects.map((p, i) => (
        <li class:list={['case', { 'case--featured': p.featured }]}>
          <article aria-labelledby={`case-${i}`}>
            {shot(p.image) && (
              <figure class="case__shot">
                <div class="case__bar" aria-hidden="true">
                  <span class="case__dots"><span /><span /><span /></span>
                  <span class="case__host">{host(p.url)}</span>
                </div>
                <Picture
                  src={shot(p.image)}
                  alt={en[`work.${i}.shot`]}
                  data-i18n={`work.${i}.shot`}
                  data-i18n-attr="alt"
                  formats={['avif', 'webp']}
                  widths={[480, 800, 1200]}
                  sizes={p.featured ? '(min-width: 1200px) 830px, (min-width: 960px) 70vw, 100vw' : '(min-width: 1200px) 410px, (min-width: 720px) 45vw, 100vw'}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            )}
            <div class="case__body">
            <header class="case__head">
              <p class="fun-only case__stage" aria-hidden="true"><span data-i18n="fun.stage">{en['fun.stage']}</span> 1-{i + 1}</p>
              <p class="label" data-i18n={`work.role.${p.role}`}>{en[`work.role.${p.role}`]}</p>
              <h3 id={`case-${i}`} class="case__name" data-i18n={`work.${i}.name`}>{t(p.name)}</h3>
              <p class="case__tagline" data-i18n={`work.${i}.tagline`}>{t(p.tagline)}</p>
              {p.metric && <p class="case__metric" data-i18n={`work.${i}.metric`}>{t(p.metric)}</p>}
            </header>

            <dl class="case__steps">
              {steps.map((k) => (
                <div>
                  <dt data-i18n={`case.${k}`}>{en[`case.${k}`]}</dt>
                  <dd data-i18n={`case.${i}.${k}`}>{t(p.case[k])}</dd>
                </div>
              ))}
            </dl>

            <footer class="case__foot">
              <div class="case__stack">
                <span class="visually-hidden" data-i18n="work.stack">{en['work.stack']}</span>
                <ul class="tags" role="list">
                  {p.tech.map((tag) => <li>{tag}</li>)}
                </ul>
              </div>
              <a class="link link--icon" href={p.url} target="_blank" rel="noopener noreferrer">
                <span data-i18n="work.visit">{en['work.visit']}</span>
                <Icon name="arrow-up-right" size={16} />
              </a>
            </footer>
            </div>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .cases {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 720px) {
    .cases {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .case--featured {
      grid-column: 1 / -1;
    }
  }

  .case article {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: var(--border-1) solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color var(--dur-base) var(--ease), box-shadow var(--dur-base) var(--ease);
  }

  .case article:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
    box-shadow: var(--shadow-md);
  }

  /* Screenshot in a light browser frame. */
  .case__shot {
    border-bottom: var(--border-1) solid var(--line);
    overflow: hidden;
  }

  .case__bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    background: var(--bg);
    border-bottom: var(--border-1) solid var(--line);
  }

  .case__dots {
    display: flex;
    gap: 5px;
  }

  .case__dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .case__host {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--faint);
  }

  .case__shot :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    transition: transform var(--dur-slow) var(--ease);
  }

  /* Featured: a wide crop of the site's header and hero. */
  .case--featured .case__shot :global(img) {
    aspect-ratio: 2 / 1;
  }

  .case article:hover .case__shot :global(img) {
    transform: scale(1.02);
  }

  .case__body {
    flex: 1;
    display: grid;
    align-content: start;
    gap: var(--space-5);
    padding: var(--space-6);
  }

  .case__name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    margin-top: var(--space-2);
  }

  .case--featured .case__name {
    font-size: var(--text-2xl);
  }

  .case__tagline {
    color: var(--muted);
    margin-top: var(--space-1);
  }

  .case__metric {
    display: inline-block;
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
  }

  .case__steps {
    display: grid;
    gap: var(--space-5);
  }

  .case--featured .case__steps {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }

  .case__steps dt {
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  .case__steps dd {
    color: var(--muted);
  }

  .case__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: auto;
  }

  @media (max-width: 720px) {
    .case__body {
      padding: var(--space-5);
    }
  }

  @media print {
    .case__shot {
      display: none;
    }

    .case article {
      border: none;
      background: none;
    }

    .case__body {
      padding: 0;
    }
  }
</style>
