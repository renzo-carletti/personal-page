---
import { profile, translations } from '../data/content.js';
const en = translations.en;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__name">
      © {year} {profile.name}
    </p>
    <p class="footer__tag">
      <span data-i18n="footer.tag">{en['footer.tag']}</span><span class="footer__heart" data-i18n="footer.word">{en['footer.word']}</span>
      <span class="footer__sig" aria-hidden="true">Renzo</span>
    </p>
    <div class="footer__links">
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={`mailto:${profile.email}`}>Email</a>
      <a href={base + 'cv.pdf'} download>CV</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--glass-border);
    padding-block: 2rem;
    padding-bottom: 5rem;
    margin-top: 2rem;
  }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer__name {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
  }

  .footer__tag {
    font-size: 0.85rem;
    color: var(--faint);
  }

  .footer__heart {
    background: linear-gradient(120deg, var(--accent-1), var(--accent-3));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 600;
  }

  .footer__sig {
    display: none;
    font-family: var(--font-note), 'Caveat', cursive;
    font-size: 1.5rem;
    color: var(--accent-2);
    margin-left: 0.6rem;
    vertical-align: -0.18em;
  }

  :root[data-theme='fun'] .footer__sig {
    display: inline;
  }

  .footer__links {
    display: flex;
    gap: 1.2rem;
  }

  .footer__links a {
    font-size: 0.85rem;
    color: var(--muted);
    border-bottom: 1px solid var(--glass-border);
    padding-bottom: 1px;
    transition: color 0.25s, border-color 0.25s;
  }

  .footer__links a:hover {
    color: var(--accent-2);
    border-color: var(--accent-2);
  }

  @media (max-width: 600px) {
    .footer__inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0.9rem;
    }
    .footer__links {
      gap: 1rem;
    }
  }

  /* Storybook colophon */
  :root[data-theme='fun'] .footer {
    border-top: 1px solid rgba(232, 182, 76, 0.35);
    position: relative;
  }

  :root[data-theme='fun'] .footer::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 50%;
    width: 7px;
    height: 7px;
    transform: translateX(-50%) rotate(45deg);
    background: #e8b64c;
    box-shadow: 0 0 8px rgba(232, 182, 76, 0.75);
  }

  :root[data-theme='fun'] .footer__inner {
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.7rem;
  }

  :root[data-theme='fun'] .footer__name {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--text);
    letter-spacing: 0.02em;
  }

  :root[data-theme='fun'] .footer__tag {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 46ch;
  }

  :root[data-theme='fun'] .footer__heart {
    background: linear-gradient(120deg, #ffd166, #e8734a);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  :root[data-theme='fun'] .footer__sig {
    font-size: 1.8rem;
    margin-left: 0.5rem;
  }

  :root[data-theme='fun'] .footer__links {
    gap: 1.4rem;
    margin-top: 0.3rem;
  }

  :root[data-theme='fun'] .footer__links a {
    font-family: var(--font-display);
    font-size: 0.95rem;
  }
</style>