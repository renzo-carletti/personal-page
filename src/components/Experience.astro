---
import Icon from './Icon.astro';
import { experience, t, translations } from '../data/content.js';
const en = translations.en;
// Bullets shown before the "more" toggle.
const LEAD = 3;
// A role still running has "Present" as its end date.
const current = (job: (typeof experience)[number]) => /present/i.test(t(job.period));
---

<section id="experience" class="section" aria-labelledby="exp-title">
  <div class="container section__grid">
    <header class="section__head">
      <span class="section__num">02</span>
      <span class="fun-only fun-label" aria-hidden="true" data-i18n="fun.exp">{en['fun.exp']}</span>
      <h2 id="exp-title" class="section__title" data-i18n="exp.title">{en['exp.title']}</h2>
    </header>

    <ol class="jobs" role="list">
      {experience.map((job, i) => (
        <li class:list={['job', { 'job--current': current(job) }]}>
          <p class="job__period">
            <span data-i18n={`exp.${i}.period`}>{t(job.period)}</span>
            {current(job) && <span class="pro-only job__now" data-i18n="exp.now">{en['exp.now']}</span>}
          </p>
          <div class="job__body">
            <h3 class="job__role" data-i18n={`exp.${i}.role`}>{t(job.role)}</h3>
            <p class="job__company">
              {job.company} · <span data-i18n={`exp.${i}.meta`}>{t(job.meta)}</span>
            </p>
            <ul class="job__bullets">
              {job.bullets.slice(0, LEAD).map((b, bi) => (
                <li data-i18n={`exp.${i}.b${bi}`}>{t(b)}</li>
              ))}
            </ul>
            {job.bullets.length > LEAD && (
              <details class="job__more">
                <summary>
                  <span data-i18n="exp.more">{en['exp.more']}</span>
                  <span class="job__count">({job.bullets.length - LEAD})</span>
                  <Icon name="chevron-down" size={16} />
                </summary>
                <ul class="job__bullets">
                  {job.bullets.slice(LEAD).map((b, bi) => (
                    <li data-i18n={`exp.${i}.b${bi + LEAD}`}>{t(b)}</li>
                  ))}
                </ul>
              </details>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .jobs {
    display: grid;
  }

  .job {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
  }

  /* Timeline rail: one continuous line down the body column, a dot per role. */
  .job__body {
    position: relative;
    padding: 0 0 var(--space-7) var(--space-6);
    border-left: var(--border-1) solid var(--line-strong);
  }

  .job:last-child .job__body {
    padding-bottom: 0;
  }

  .job__body::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 0.45rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg);
    border: var(--border-2) solid var(--line-strong);
  }

  .job--current .job__body::before {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .job__now {
    display: inline-block;
    margin-left: var(--space-2);
    padding: 0 var(--space-2);
    font-size: var(--text-xs);
    color: var(--accent);
    border: var(--border-1) solid currentColor;
    border-radius: var(--radius-pill);
  }

  @media (max-width: 719px) {
    .job__period {
      padding-left: var(--space-6);
      border-left: var(--border-1) solid var(--line-strong);
    }

    .job:first-child .job__period {
      border-left-color: transparent;
    }
  }

  @media (min-width: 720px) {
    .job {
      grid-template-columns: 10rem minmax(0, 1fr);
      gap: var(--space-6);
    }
  }

  .job__period {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--faint);
    padding-top: 0.3rem;
  }

  .job__role {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 500;
  }

  .job__company {
    color: var(--muted);
    font-size: var(--text-sm);
    margin-top: var(--space-1);
  }

  .job__bullets {
    margin-top: var(--space-4);
    padding-left: 1.1rem;
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
  }

  .job__bullets li::marker {
    color: var(--accent);
  }

  .job__more summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--accent);
    cursor: pointer;
    list-style: none;
  }

  .job__more summary::-webkit-details-marker {
    display: none;
  }

  .job__more summary :global(.icon) {
    transition: transform var(--dur-base) var(--ease);
  }

  .job__more[open] summary :global(.icon) {
    transform: rotate(180deg);
  }

  .job__count {
    color: var(--faint);
  }

  @media print {
    .job__body {
      border-left: none;
      padding: 0 0 0.6rem;
    }

    .job__body::before {
      content: none;
    }

    .job__more summary {
      display: none;
    }

    .job__more .job__bullets {
      margin-top: 0.5rem;
    }
  }
</style>
