---
import Icon from './Icon.astro';
import HeroScene from './fun/HeroScene.astro';
import { farRidge, midRidge, hill3, hillLine } from './scene.js';
import { profile, stats, t, translations } from '../data/content.js';
const en = translations.en;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section id="top" class="hero container" aria-labelledby="hero-name">
  <svg class="pro-only hero__ridges" viewBox="0 196 1440 224" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path class="hero__ridge" d={farRidge} />
    <path class="hero__ridge hero__ridge--accent" d={midRidge} />
    <path class="hero__ridge" d={hillLine(hill3)} />
  </svg>
  <div class="hero__main">
    <p class="pro-only hero__status">
      <span class="hero__dot" aria-hidden="true"></span>
      <span data-i18n="hero.available">{en['hero.available']}</span>
    </p>
    <p class="hero__role" data-i18n="hero.role">{t(profile.role)}</p>
    <h1 id="hero-name" class="hero__name">{profile.name}</h1>
    <p class="hero__tagline" data-i18n="hero.tagline">{t(profile.tagline)}</p>
    <p class="hero__summary" data-i18n="hero.summary">{t(profile.summary)}</p>

    <div class="hero__actions">
      <a class="fun-only btn btn--start" href="#work" data-i18n="fun.start">{en['fun.start']}</a>
      <a class="btn btn--primary" href="#contact">
        <Icon name="mail" size={16} />
        <span data-i18n="hero.contact">{en['hero.contact']}</span>
      </a>
      <a class="btn btn--ghost" href={base + 'renzo-carletti-cv.pdf'} download data-cv>
        <Icon name="download" size={16} />
        <span data-i18n="hero.download">{en['hero.download']}</span>
      </a>
    </div>
  </div>

  <aside class="hero__aside" aria-labelledby="hero-facts">
    <h2 id="hero-facts" class="label" data-i18n="hero.facts">{en['hero.facts']}</h2>
    <dl class="hero__facts">
      <div>
        <dt data-i18n="hero.based">{en['hero.based']}</dt>
        <dd data-i18n="hero.basedValue">{en['hero.basedValue']}</dd>
      </div>
      <div>
        <dt data-i18n="hero.now">{en['hero.now']}</dt>
        <dd data-i18n="about.current.text">{t(profile.current)}</dd>
      </div>
      <div>
        <dt data-i18n="hero.langs">{en['hero.langs']}</dt>
        <dd data-i18n="hero.langsValue">{en['hero.langsValue']}</dd>
      </div>
    </dl>
    <ul class="hero__links" role="list">
      <li><a class="link link--icon" href={profile.linkedin} target="_blank" rel="noopener noreferrer" data-print-url="false"><Icon name="linkedin" size={16} />LinkedIn</a></li>
      <li><a class="link link--icon" href={profile.github} target="_blank" rel="noopener noreferrer" data-print-url="false"><Icon name="github" size={16} />GitHub</a></li>
      <li><a class="link link--icon" href={`mailto:${profile.email}`}><Icon name="mail" size={16} />{profile.email}</a></li>
    </ul>
  </aside>

  <dl class="hero__numbers" aria-label={en['hero.numbers']} data-i18n="hero.numbers" data-i18n-attr="aria-label">
    {stats.map((s) => (
      <div>
        <dt data-i18n={`hero.stats.${s.id}`}>{t(s.label)}</dt>
        <dd data-i18n={`hero.stats.${s.id}.value`}>{en[`hero.stats.${s.id}.value`]}</dd>
      </div>
    ))}
  </dl>
  <!-- Last in the DOM so Vivi comes after the hero actions in tab order. -->
  <HeroScene />
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    padding-block: var(--space-8) calc(var(--space-9) + clamp(70px, 9vw, 130px));
  }

  /* Line-art echo of the fun mode landscape, full bleed under the hero. */
  .hero__ridges {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 100vw;
    max-width: none;
    height: clamp(90px, 11vw, 160px);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .hero__ridge {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
  }

  .hero__ridge--accent {
    stroke: var(--accent);
    opacity: 0.55;
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    color: var(--muted);
    border: var(--border-1) solid var(--line);
    border-radius: var(--radius-pill);
  }

  .hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--success) 25%, transparent);
  }

  @media (min-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      column-gap: var(--space-8);
      padding-top: var(--space-9);
    }
  }

  .hero__role {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
    margin-bottom: var(--space-4);
  }

  .hero__name {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .hero__tagline {
    margin-top: var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    line-height: var(--leading-snug);
    max-width: 30ch;
  }

  .hero__summary {
    margin-top: var(--space-5);
    color: var(--muted);
    max-width: var(--measure);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .hero__aside {
    align-self: end;
    padding-top: var(--space-5);
    border-top: var(--border-1) solid var(--line);
  }

  @media (min-width: 960px) {
    .hero__aside {
      border-top: none;
      padding-top: 0;
      padding-left: var(--space-6);
      border-left: var(--border-1) solid var(--line);
    }
  }

  .hero__facts {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .hero__facts dt {
    font-size: var(--text-sm);
    color: var(--faint);
  }

  .hero__facts dd {
    font-size: var(--text-sm);
  }

  .hero__links {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-5);
    font-size: var(--text-sm);
  }

  .hero__links .link {
    word-break: break-word;
  }

  .hero__numbers {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    border-top: var(--border-1) solid var(--line);
  }

  .hero__numbers > div {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-5) var(--space-5) 0 0;
  }

  /* Short accent rule above each number. */
  .hero__numbers > div::before {
    content: '';
    order: -2;
    width: 1.5rem;
    height: 2px;
    margin-bottom: var(--space-3);
    background: var(--accent);
  }

  .hero__numbers dd {
    order: -1;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-variant-numeric: lining-nums tabular-nums;
    line-height: 1;
  }

  .hero__numbers dt {
    font-size: var(--text-sm);
    color: var(--muted);
    max-width: 22ch;
  }

  @media print {
    .hero {
      padding-block: 0 1rem;
      gap: 1rem;
    }

    .hero__actions,
    .hero__ridges,
    .hero__status {
      display: none;
    }

    .hero__name {
      font-size: 2.4rem;
    }

    .hero__numbers dd {
      font-size: 1.4rem;
    }
  }
</style>
