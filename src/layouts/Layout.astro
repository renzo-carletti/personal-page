---
import newsLatin from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import newsLatinExt from '@fontsource-variable/newsreader/files/newsreader-latin-ext-wght-normal.woff2?url';
import publicLatin from '@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url';
import publicLatinExt from '@fontsource-variable/public-sans/files/public-sans-latin-ext-wght-normal.woff2?url';
import jbLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import jbLatinExt from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-ext-wght-normal.woff2?url';
import pixLatin from '@fontsource/jersey-10/files/jersey-10-latin-400-normal.woff2?url';
import pixLatinExt from '@fontsource/jersey-10/files/jersey-10-latin-ext-400-normal.woff2?url';
import '../styles/global.css';
import '../styles/fun.css';
import Nav from '../components/Nav.astro';
import Icon from '../components/Icon.astro';
import FunLayer from '../components/fun/FunLayer.astro';
import { profile, t, translations } from '../data/content.js';
const en = translations.en;

const { title = en['meta.title'] } = Astro.props;

const siteUrl = (Astro.site ?? 'https://renzocarletti.dev').href.replace(/\/$/, '');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const fontCss = `
@font-face {
  font-family: 'Newsreader Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 200 800;
  src: url('${newsLatin}') format('woff2-variations');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'Newsreader Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 200 800;
  src: url('${newsLatinExt}') format('woff2-variations');
  unicode-range: U+0100-024F, U+0259, U+1E00-1EFF, U+2020, U+20A0-20AB, U+20AD-20CF, U+2113, U+2C60-2C7F, U+A720-A7FF;
}
@font-face {
  font-family: 'Public Sans Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 900;
  src: url('${publicLatin}') format('woff2-variations');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'Public Sans Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 900;
  src: url('${publicLatinExt}') format('woff2-variations');
  unicode-range: U+0100-024F, U+0259, U+1E00-1EFF, U+2020, U+20A0-20AB, U+20AD-20CF, U+2113, U+2C60-2C7F, U+A720-A7FF;
}
@font-face {
  font-family: 'JetBrains Mono Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 800;
  src: url('${jbLatin}') format('woff2-variations');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'JetBrains Mono Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 800;
  src: url('${jbLatinExt}') format('woff2-variations');
  unicode-range: U+0100-024F, U+0259, U+1E00-1EFF, U+2020, U+20A0-20AB, U+20AD-20CF, U+2113, U+2C60-2C7F, U+A720-A7FF;
}
/* Fun mode only: the browser fetches it the first time fun styles use it. */
@font-face {
  font-family: 'Jersey 10';
  font-style: normal;
  font-display: swap;
  font-weight: 400;
  src: url('${pixLatin}') format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'Jersey 10';
  font-style: normal;
  font-display: swap;
  font-weight: 400;
  src: url('${pixLatinExt}') format('woff2');
  unicode-range: U+0100-024F, U+0259, U+1E00-1EFF, U+2020, U+20A0-20AB, U+20AD-20CF, U+2113, U+2C60-2C7F, U+A720-A7FF;
}
`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: t(profile.role),
  email: `mailto:${profile.email}`,
  telephone: profile.phone.replace(/\s/g, ''),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Paraná',
    addressRegion: 'Entre Ríos',
    addressCountry: 'AR',
  },
  url: siteUrl,
  sameAs: [profile.linkedin, profile.github],
  knowsAbout: [
    'React.js', 'Drupal', 'Moodle', 'REST APIs', 'JSON:API', 'OAuth2',
    'PHP', 'Headless CMS', 'DevOps', 'Docker', 'Kubernetes', 'AWS',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={en['meta.description']} data-i18n="meta.description" data-i18n-attr="content" />
    <meta name="keywords" content="Drupal developer, Drupal upgrades, Drupal migration, Decoupled Drupal, Headless CMS, React, JSON:API, REST APIs, GraphQL, Moodle, PHP, Argentina" />
    <meta name="author" content="Renzo Emiliano Carletti" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#101214" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      try {
        const root = document.documentElement;
        if (localStorage.getItem('rc-theme') === 'fun') root.dataset.theme = 'fun';
        const scheme = localStorage.getItem('rc-scheme');
        root.dataset.scheme = scheme === 'light' || scheme === 'dark' ? scheme : matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      } catch (e) {}
    </script>
    <link rel="icon" type="image/svg+xml" href={base + 'favicon.svg'} />
    <link rel="canonical" href={siteUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={en['meta.description']} />
    <meta property="og:image" content={`${siteUrl}/og.png`} />
    <meta property="og:site_name" content="Renzo Carletti" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${siteUrl}/og.png`} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={en['meta.description']} />

    <title>{title}</title>

    <link rel="preload" href={publicLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={newsLatin} as="font" type="font/woff2" crossorigin />

    <style is:global set:html={fontCss} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <FunLayer />
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
    <button id="back-to-top" class="back-to-top" aria-label={en['footer.top']} data-i18n="footer.top" data-i18n-attr="aria-label">
      <Icon name="arrow-up" />
    </button>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script>
      import '../scripts/scroll-ui.js';
    </script>
  </body>
</html>