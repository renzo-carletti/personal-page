---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const links = [
  { href: '#about', label: 'About', i18n: 'nav.about' },
  { href: '#experience', label: 'Experience', i18n: 'nav.experience' },
  { href: '#work', label: 'Work', i18n: 'nav.work' },
  { href: '#skills', label: 'Skills', i18n: 'nav.skills' },
  { href: '#certifications', label: 'Certifications', i18n: 'nav.certs' },
  { href: '#contact', label: 'Contact', i18n: 'nav.contact' },
];
---

<header class="nav">
  <div class="container nav__inner">
    <nav class="nav__links" aria-label="Primary">
      {links.map((l, i) => (
        <a href={l.href} data-i18n={l.i18n} style={`--i:${i}`}>{l.label}</a>
      ))}
      <div class="nav__controls" role="group" aria-label="Language and appearance">
        <button data-lang-btn="en" class="nav__lang" aria-pressed="false" aria-label="Switch to English">EN</button>
        <button data-lang-btn="es" class="nav__lang" aria-pressed="false" aria-label="Cambiar a español">ES</button>
        <button id="theme-toggle" class="nav__theme" aria-pressed="false" data-i18n="nav.theme" data-i18n-attr="aria-label" title="Fun mode">
          <svg class="icon-fun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 12h4M8 10v4M15 12h.01M18 10h.01" />
            <path d="M17.32 5H6.68A4.68 4.68 0 0 0 2 9.68c0 2.1 1.05 4.04 2.8 5.22l.7.5a1 1 0 0 1 .26 1.35l-.92 1.42a1.5 1.5 0 0 0 2.2 1.95l2.06-1.83a1.5 1.5 0 0 1 1.98 0l2.06 1.83a1.5 1.5 0 0 0 2.2-1.95l-.92-1.42a1 1 0 0 1 .26-1.35l.7-.5A5.68 5.68 0 0 0 22 9.68 4.68 4.68 0 0 0 17.32 5Z" />
          </svg>
          <svg class="icon-pro" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="7" width="20" height="14" rx="2" />
            <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
            <path d="M2 13h20" />
          </svg>
        </button>
        <button id="bw-toggle" class="nav__bw" aria-pressed="false" aria-label="Toggle black and white mode" title="Black & white">◐</button>
      </div>
      <a class="nav__cta" href={base + 'cv.pdf'} data-i18n="nav.download" download>Download CV</a>
    </nav>

    <button class="nav__toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="nav__mobile" id="mobile-menu">
    {links.map((l) => (
      <a href={l.href} data-i18n={l.i18n}>{l.label}</a>
    ))}
    <div class="nav__controls nav__controls--mobile" role="group" aria-label="Language and appearance">
      <button data-lang-btn="en" class="nav__lang" aria-pressed="false" aria-label="Switch to English">EN</button>
      <button data-lang-btn="es" class="nav__lang" aria-pressed="false" aria-label="Cambiar a español">ES</button>
      <button id="theme-toggle-mobile" class="nav__theme" aria-pressed="false" data-i18n="nav.theme" data-i18n-attr="aria-label" title="Fun mode">
        <svg class="icon-fun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 12h4M8 10v4M15 12h.01M18 10h.01" />
          <path d="M17.32 5H6.68A4.68 4.68 0 0 0 2 9.68c0 2.1 1.05 4.04 2.8 5.22l.7.5a1 1 0 0 1 .26 1.35l-.92 1.42a1.5 1.5 0 0 0 2.2 1.95l2.06-1.83a1.5 1.5 0 0 1 1.98 0l2.06 1.83a1.5 1.5 0 0 0 2.2-1.95l-.92-1.42a1 1 0 0 1 .26-1.35l.7-.5A5.68 5.68 0 0 0 22 9.68 4.68 4.68 0 0 0 17.32 5Z" />
        </svg>
        <svg class="icon-pro" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="7" width="20" height="14" rx="2" />
          <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
          <path d="M2 13h20" />
        </svg>
      </button>
      <button id="bw-toggle-mobile" class="nav__bw" aria-pressed="false" aria-label="Toggle black and white mode">◐</button>
    </div>
    <a class="nav__cta" href={base + 'cv.pdf'} data-i18n="nav.download" download>Download CV</a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    padding-block: 0.9rem;
    transition: background 0.3s, border-color 0.3s, backdrop-filter 0.3s;
    border-bottom: 1px solid transparent;
  }

  .nav.scrolled {
    background: rgba(5, 6, 15, 0.72);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    border-bottom-color: var(--glass-border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 1.8rem;
  }

  .nav__links a {
    font-size: 0.9rem;
    color: var(--muted);
    font-weight: 500;
    position: relative;
    transition: color 0.25s;
  }

  .nav__controls {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem;
    border-radius: 999px;
    border: 1px solid var(--glass-border);
    background: var(--glass);
  }

  .nav__lang,
  .nav__bw,
  .nav__theme {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    color: var(--muted);
    transition: color 0.25s, background 0.25s;
  }

  .nav__theme {
    display: inline-flex;
    align-items: center;
  }

  .nav__theme svg {
    width: 14px;
    height: 14px;
  }

  .nav__theme .icon-fun {
    display: none;
  }

  .nav__theme .icon-pro {
    display: block;
  }

  html[data-theme='fun'] .nav__theme .icon-fun {
    display: block;
  }

  html[data-theme='fun'] .nav__theme .icon-pro {
    display: none;
  }

  .nav__bw {
    font-size: 0.9rem;
    line-height: 1;
    padding: 0.3rem 0.55rem;
  }

  .nav__lang:hover,
  .nav__bw:hover,
  .nav__theme:hover {
    color: var(--text);
  }

  .nav__lang.active {
    color: #fff;
    background: var(--accent-grad-solid);
  }

  .nav__bw.active,
  .nav__theme.active {
    color: var(--text);
    background: var(--glass-hover);
  }

  .nav__links a:not(.nav__cta)::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--accent-1), var(--accent-2));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }

  .nav__links a:not(.nav__cta):hover {
    color: var(--text);
  }

  .nav__links a:not(.nav__cta):hover::after {
    transform: scaleX(1);
  }

  .nav__links a.active {
    color: var(--text);
  }

  .nav__links a.active::after {
    transform: scaleX(1);
  }

  .nav__cta {
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--glass-border);
    background: var(--glass);
    color: var(--text) !important;
    transition: background 0.25s, transform 0.25s var(--ease);
  }

  .nav__cta:hover {
    background: var(--glass-hover);
    transform: translateY(-1px);
  }

  .nav__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 0.4rem;
  }

  .nav__toggle span {
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: var(--text);
    transition: transform 0.3s var(--ease), opacity 0.3s;
  }

  .nav__toggle[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav__toggle[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .nav__toggle[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .nav__mobile {
    display: none;
  }

  @media (max-width: 1100px) {
    .nav__links { display: none; }
    .nav__toggle { display: flex; }

    .nav__mobile {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      padding: 1rem 1.5rem 1.4rem;
      background: rgba(5, 6, 15, 0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--glass-border);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      pointer-events: none;
      transition: opacity 0.3s var(--ease), transform 0.3s var(--ease), visibility 0s linear 0.3s;
    }

    .nav__mobile.open {
      opacity: 1;
      visibility: visible;
      transform: none;
      pointer-events: auto;
      transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
    }

    .nav__mobile a {
      padding: 0.7rem 0.5rem;
      border-radius: var(--radius-sm);
      color: var(--muted);
      font-weight: 500;
    }

    .nav__mobile a:hover {
      background: var(--glass);
      color: var(--text);
    }

    .nav__mobile .nav__cta {
      margin-top: 0.5rem;
      text-align: center;
    }

    .nav__controls--mobile {
      margin-block: 0.6rem;
      align-self: flex-start;
    }
  }
</style>

<script>
  import { setLang } from '../scripts/i18n.js';
  import { initFunFx, destroyFunFx } from '../scripts/fun-fx.js';
  import { initGameFx, destroyGameFx } from '../scripts/game-fx.js';

  const header = document.querySelector('.nav');
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const toggle = document.querySelector('.nav__toggle');
  const mobile = document.querySelector('.nav__mobile');
  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    mobile.classList.toggle('open', !open);
  });

  mobile.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      toggle.setAttribute('aria-expanded', 'false');
      mobile.classList.remove('open');
    });
  });

  document.querySelectorAll('[data-lang-btn]').forEach((btn) => {
    btn.addEventListener('click', () => setLang(btn.dataset.langBtn));
  });

  const BW_KEY = 'rc-bw';
  const bwBtns = document.querySelectorAll('.nav__bw');
  function isBw() {
    return document.documentElement.classList.contains('bw');
  }
  function setBw(on) {
    localStorage.setItem(BW_KEY, on ? '1' : '0');
    document.documentElement.classList.toggle('bw', on);
    bwBtns.forEach((b) => {
      b.classList.toggle('active', on);
      b.setAttribute('aria-pressed', String(on));
    });
  }
  setBw(localStorage.getItem(BW_KEY) === '1');
  bwBtns.forEach((b) => b.addEventListener('click', () => setBw(!isBw())));
  window.addEventListener('storage', (e) => {
    if (e.key === BW_KEY) setBw(e.newValue === '1');
  });

  const THEME_KEY = 'rc-theme';
  const themeBtns = document.querySelectorAll('.nav__theme');
  function isFun() {
    return document.documentElement.dataset.theme === 'fun';
  }
  function setTheme(fun) {
    localStorage.setItem(THEME_KEY, fun ? 'fun' : 'pro');
    if (fun) document.documentElement.dataset.theme = 'fun';
    else delete document.documentElement.dataset.theme;
    themeBtns.forEach((b) => {
      b.classList.toggle('active', fun);
      b.setAttribute('aria-pressed', String(fun));
    });
    if (fun) initFunFx();
    else destroyFunFx();
    if (fun) initGameFx();
    else destroyGameFx();
  }
  setTheme(localStorage.getItem(THEME_KEY) === 'fun');
  themeBtns.forEach((b) => b.addEventListener('click', () => setTheme(!isFun())));
  window.addEventListener('storage', (e) => {
    if (e.key === THEME_KEY) setTheme(e.newValue === 'fun');
  });
</script>